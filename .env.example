# Recommended for local development. Copy this file to `.env.local`, then
# replace the placeholder with the backend URL. `.env.local` is ignored by Git.
SLEEPY_DEV_PROXY_TARGET=http://backend-host.example:9011

# Optional alternative: make the browser call the backend directly. This
# requires the backend to allow http://localhost:4321 in SLEEPY_CORS_ORIGINS.
# PUBLIC_SLEEPY_API_BASE=http://backend-host.example:9011
