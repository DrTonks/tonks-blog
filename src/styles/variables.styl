/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

:root
  --hue 250
  --radius-large 1rem
  --content-delay 150ms
  --motion-signal-fast 160ms
  --motion-signal-medium 260ms
  --ease-signal cubic-bezier(0.2, 0.8, 0.2, 1)
  --ease-cut cubic-bezier(0.7, 0, 0.3, 1)
  --ambient-pointer-strength 13%
  --ambient-pointer-opacity 1

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.70 0.14 var(--hue)) oklch(0.75 0.14 var(--hue))
  --signal: oklch(0.93 0.045 250) oklch(0.70 0.13 245)
  --signal-ink: oklch(0.24 0.055 250) oklch(0.15 0.035 250)
  --signal-soft: rgba(68, 142, 245, 0.15) rgba(72, 173, 255, 0.14)
  --signal-line: rgba(54, 122, 220, 0.46) rgba(100, 196, 255, 0.5)
  --access-signal: #fff200 oklch(0.78 0.16 98)
  --access-ink: oklch(0.20 0.02 98) oklch(0.17 0.02 98)
  --access-line: rgba(175, 160, 0, 0.58) rgba(238, 220, 87, 0.56)
  --industrial-surface: oklch(0.975 0.01 250) oklch(0.205 0.012 250)
  --industrial-surface-hover: oklch(0.94 0.025 250) oklch(0.255 0.025 250)
  --project-accent: oklch(0.55 0.17 245) oklch(0.78 0.13 225)
  --project-accent-strong: oklch(0.46 0.18 250) oklch(0.84 0.12 220)
  --project-accent-soft: rgba(42, 132, 244, 0.12) rgba(58, 181, 255, 0.15)
  --project-accent-surface: rgba(224, 240, 255, 0.72) rgba(16, 55, 82, 0.68)
  --project-accent-line: rgba(28, 111, 218, 0.34) rgba(93, 199, 255, 0.42)
  --project-accent-glow: rgba(35, 121, 231, 0.18) rgba(61, 187, 255, 0.22)
  --project-panel-shadow: rgba(21, 38, 61, 0.12) rgba(0, 0, 0, 0.28)
  --project-panel-highlight: rgba(255, 255, 255, 0.32) rgba(255, 255, 255, 0.07)
  --timeline-ghost-fill: rgba(45, 88, 148, 0.024) rgba(154, 211, 255, 0.028)
  --timeline-ghost-line: rgba(45, 88, 148, 0.17) rgba(154, 211, 255, 0.2)
  --timeline-ghost-line-mobile: rgba(45, 88, 148, 0.095) rgba(154, 211, 255, 0.115)
  --timeline-card-shadow: rgba(19, 45, 77, 0.045) rgba(16, 40, 70, 0.045)
  --timeline-active-shadow: rgba(28, 91, 158, 0.16) rgba(100, 196, 255, 0.2)
  --page-bg: oklch(0.95 0.01 var(--hue)) oklch(0.16 0.014 var(--hue))
  --card-bg: white oklch(0.23 0.015 var(--hue))
  --card-bg-transparent: rgba(255, 255, 255, 0.8) rgba(23, 23, 23, 0.8)

  --btn-content: oklch(0.55 0.12 var(--hue)) oklch(0.75 0.1 var(--hue))

  --btn-regular-bg: oklch(0.95 0.025 var(--hue)) oklch(0.33 0.035 var(--hue))
  --btn-regular-bg-hover: oklch(0.9 0.05 var(--hue)) oklch(0.38 0.04 var(--hue))
  --btn-regular-bg-active: oklch(0.85 0.08 var(--hue)) oklch(0.43 0.045 var(--hue))

  --btn-plain-bg-hover: oklch(0.95 0.025 var(--hue)) oklch(0.30 0.035 var(--hue))
  --btn-plain-bg-active: oklch(0.98 0.01 var(--hue)) oklch(0.27 0.025 var(--hue))

  --btn-card-bg-hover: oklch(0.98 0.005 var(--hue)) oklch(0.3 0.03 var(--hue))
  --btn-card-bg-active: oklch(0.9 0.03 var(--hue)) oklch(0.35 0.035 var(--hue))

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.25 0.02 var(--hue))

  --title-active: oklch(0.6 0.1 var(--hue))

  --line-divider: black(0.08) white(0.08)

  --line-color: black(0.1) white(0.1)
  --meta-divider: black(0.2) white(0.2)
  --content-meta: black(0.7) white(0.6)
  --text-secondary: #526174 #b6c2d2
  --text-muted: #566477 #a7b5c8
  --text-accent: oklch(0.46 0.12 var(--hue)) oklch(0.80 0.12 var(--hue))

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.90 0.05 var(--hue)) oklch(0.40 0.08 var(--hue))
  --codeblock-selection: oklch(0.40 0.08 var(--hue))
  --codeblock-bg: oklch(0.17 0.015 var(--hue)) oklch(0.17 0.015 var(--hue))
  --codeblock-topbar-bg: oklch(0.3 0.02 var(--hue)) oklch(0.12 0.015 var(--hue))

  --license-block-bg: black(0.03) var(--codeblock-bg)

  --link-underline: oklch(0.93 0.04 var(--hue)) oklch(0.40 0.08 var(--hue))
  --link-hover: oklch(0.95 0.025 var(--hue)) oklch(0.40 0.08 var(--hue))
  --link-active: oklch(0.90 0.05 var(--hue)) oklch(0.35 0.07 var(--hue))

  --float-panel-bg: white oklch(0.19 0.015 var(--hue))

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: oklch(0.9 0.045 var(--hue)) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.92 0.015 var(--hue)) oklch(0.22 0.02 var(--hue))
  --toc-btn-active: oklch(0.90 0.015 var(--hue)) oklch(0.25 0.02 var(--hue))
  --toc-width: unquote('min(calc((100vw - var(--page-width)) / 2 - 1rem), 31.25rem)')
  --toc-item-active: oklch(0.70 0.13 var(--hue)) oklch(0.35 0.07 var(--hue))
})

/* Presets own the complete semantic accent palette. `--hue` remains an
   internal compatibility token for older generic components only. */
:root:not(.dark)[data-accent-light='blue']
  --hue 250

:root:not(.dark)[data-accent-light='gold']
  --hue 100
  --primary oklch(0.62 0.16 98)
  --signal oklch(0.93 0.14 101)
  --signal-ink oklch(0.25 0.08 92)
  --signal-soft rgba(222, 194, 22, 0.12)
  --signal-line rgba(188, 168, 0, 0.48)
  --industrial-surface oklch(0.975 0.009 100)
  --industrial-surface-hover oklch(0.94 0.03 100)
  --project-accent oklch(0.60 0.17 98)
  --project-accent-strong oklch(0.52 0.18 96)
  --project-accent-soft rgba(222, 194, 22, 0.11)
  --project-accent-surface rgba(250, 247, 176, 0.58)
  --project-accent-line rgba(188, 168, 0, 0.36)
  --project-accent-glow rgba(222, 194, 22, 0.13)
  --timeline-ghost-fill rgba(146, 132, 0, 0.022)
  --timeline-ghost-line rgba(146, 132, 0, 0.15)
  --timeline-ghost-line-mobile rgba(146, 132, 0, 0.085)
  --timeline-card-shadow rgba(86, 82, 14, 0.05)
  --timeline-active-shadow rgba(176, 160, 0, 0.15)
  --page-bg oklch(0.965 0.008 100)
  --card-bg white

:root.dark[data-accent-dark='blue']
  --hue 250

:root.dark[data-accent-dark='gold']
  --hue 98
  --primary oklch(0.84 0.18 100)
  --signal oklch(0.87 0.17 101)
  --signal-ink oklch(0.17 0.04 92)
  --signal-soft rgba(255, 224, 42, 0.11)
  --signal-line rgba(255, 232, 94, 0.62)
  /* Gold remains the signal color; structural surfaces use neutral graphite. */
  --industrial-surface #202429
  --industrial-surface-hover #292e33
  --project-accent oklch(0.84 0.16 99)
  --project-accent-strong oklch(0.90 0.15 102)
  --project-accent-soft rgba(255, 226, 44, 0.13)
  --project-accent-surface rgba(78, 72, 14, 0.60)
  --project-accent-line rgba(255, 232, 96, 0.46)
  --project-accent-glow rgba(255, 226, 58, 0.17)
  --project-panel-shadow rgba(18, 12, 23, 0.34)
  --project-panel-highlight rgba(232, 240, 248, 0.055)
  --timeline-ghost-fill rgba(255, 232, 112, 0.03)
  --timeline-ghost-line rgba(255, 232, 112, 0.19)
  --timeline-ghost-line-mobile rgba(255, 232, 112, 0.11)
  --timeline-card-shadow rgba(255, 222, 76, 0.045)
  --timeline-active-shadow rgba(255, 226, 74, 0.16)
  --ambient-pointer-strength 7%
  --ambient-pointer-opacity 0.82
  --card-depth-shadow rgba(18, 12, 23, 0.34)
  --card-edge-highlight rgba(232, 240, 248, 0.055)
  --page-bg #111315
  --card-bg #1b1e21
  --card-bg-transparent rgba(27, 30, 33, 0.82)
  --float-panel-bg #181b1e
  --btn-regular-bg #25292e
  --btn-regular-bg-hover #2d3238
  --btn-regular-bg-active #353b42
  --btn-plain-bg-hover #23272c
  --btn-plain-bg-active #1f2327
  --btn-card-bg-hover #25292e
  --btn-card-bg-active #2d3238
  --toc-btn-hover #1f2327
  --toc-btn-active #25292e
  --codeblock-bg #141619
  --codeblock-topbar-bg #0f1113
