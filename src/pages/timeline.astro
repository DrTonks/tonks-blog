---
import TimelineClient from "../components/TimelineClient.svelte";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { timelineData } from "../data/timeline";
import { resolveTimelineIcons } from '../utils/timeline-icons.server';

const nodeIcons = resolveTimelineIcons(timelineData);

// Render the complete timeline in HTML; Svelte adds scroll-state enhancement after hydration.

const title = i18n(I18nKey.timeline);
const subtitle = i18n(I18nKey.timelineSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
  <section class="timeline-page-heading prose prose-lg dark:prose-invert mb-6 font-hanalei">
    <h1 class="text-2xl lg:text-3xl font-bold">{title}</h1>
    <p class="page-intro-caption">{subtitle}</p>
  </section>

  <TimelineClient initialItems={timelineData} nodeIcons={nodeIcons} client:load />
</MainGridLayout>

<style>

  .timeline-page-heading h1 {
    margin: 0;
  }
</style>

<style>
  p.page-intro-caption {
    font: 400 1rem/1.75 system-ui, "PingFang SC", "Microsoft YaHei", sans-serif;
    letter-spacing: .025em;
    color: var(--text-secondary);
    margin-block: .65rem 0;
  }
</style>
