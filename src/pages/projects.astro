---
import ProjectsClient from "../components/ProjectsClient.svelte";
import { projectsData } from "../data/projects";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const title = i18n(I18nKey.projects);
const subtitle = i18n(I18nKey.projectsSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
  <div class="project-shell flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-5 py-6 md:px-9 relative w-full">
      <header class="project-intro">
        <div class="project-intro__copy">
          <h1 class="font-hanalei text-4xl font-bold text-black/90 dark:text-white/90 mb-2">
          {i18n(I18nKey.projects)}
          </h1>
          <p class="page-intro-caption">{i18n(I18nKey.projectsSubtitle)}</p>
        </div>
      </header>

      <!-- Cards, statistics and home stickers share the same build-time data. -->
      <ProjectsClient projects={projectsData} client:load />
    </div>
  </div>
</MainGridLayout>

<style>
  .project-shell { color: rgba(0, 0, 0, 0.9); }
  :global(html.dark) .project-shell { color: rgba(255, 255, 255, 0.9); }
  .project-intro { padding-bottom: 1.25rem; }
  .project-intro__copy p { margin: 0; color: var(--text-secondary); font-size: 1rem; }
</style>

<style>
  p.page-intro-caption {
    font: 400 1rem/1.75 system-ui, "PingFang SC", "Microsoft YaHei", sans-serif;
    letter-spacing: .025em;
    color: var(--text-secondary);
    margin-block: .65rem 0;
  }
</style>
