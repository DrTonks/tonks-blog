---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import BlogLike from "@components/community/BlogLike.astro";
import CommunityComments from "@components/community/CommunityComments.astro";
import GitHubRepoCard from "@components/misc/GitHubRepoCard.astro";
import { getCdnUrl } from "../config/cdn";
import { Icon } from "astro-icon/components";
import asyaImage from "../content/spec/asya.jpg";
import modelImage from "../content/spec/model.jpg";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const title = i18n(I18nKey.about);
const publishedPosts = await getCollection(
	"posts",
	({ data }) => data.draft !== true,
);
const postWordCounts = await Promise.all(
	publishedPosts.map(async (post) => {
		const { remarkPluginFrontmatter } = await render(post);
		return Number(remarkPluginFrontmatter?.words ?? 0);
	}),
);
const totalWords = postWordCounts.reduce((total, words) => total + words, 0);
const totalWordsInThousands = (totalWords / 1000)
	.toFixed(1)
	.replace(/\.0$/, "");
const siteStartTime = new Date("2025-10-01T00:00:00+08:00").getTime();
const siteRunningDays = Math.max(
	1,
	Math.floor((Date.now() - siteStartTime) / 86_400_000) + 1,
);
const homePreviewLocal = "/images/projects/personalWebsite2.png";
const homePreviewSrc = getCdnUrl(homePreviewLocal) ?? homePreviewLocal;

const aboutRoutes = [
	{
		name: "浏览归档",
		note: "文章与分类",
		href: "/archive/",
		icon: "material-symbols:archive",
	},
	{
		name: "坐坐时光机",
		note: "翻翻时间的痕迹",
		href: "/timeline/",
		icon: "material-symbols:history-rounded",
	},
	{
		name: "拜访友链",
		note: "互联网邻居",
		href: "/friends/",
		icon: "material-symbols:groups",
	},
];
---

<MainGridLayout title={title}>
	<article class="about-shell card-base" data-pagefind-body>
		<section class="about-hero" aria-labelledby="about-title">
			<span class="about-hero__register" aria-hidden="true">FILE / ABOUT / 01</span>
			<div class="about-hero__copy">
				<span class="signal-kicker">PERSONAL SITE / FIELD NOTES</span>
				<div class="about-hero__title-row">
					<div>
						<h1 id="about-title" class="font-hanalei">{title}</h1>
						<p>记录我的近况，分享我的喜悦</p>
					</div>
					<BlogLike target="page:about" variant="about" />
				</div>
				<div class="about-hero__coordinate" aria-hidden="true">
					<span>25.10 — NOW</span>
					<span>ON THE INTERNET</span>
				</div>
			</div>

			<dl class="about-record" aria-label="站点档案">
				<div><dt>UPTIME</dt><dd><span aria-hidden="true"></span>{siteRunningDays} 天</dd></div>
				<div><dt>VISITS</dt><dd data-site-visit-count>— 次</dd></div>
				<div><dt>POSTS</dt><dd>{publishedPosts.length} 篇</dd></div>
				<div><dt>WORDS</dt><dd>{totalWordsInThousands}K</dd></div>
			</dl>

			<nav class="about-routes" aria-label="关于本站相关页面">
				{aboutRoutes.map((route, index) => (
					<a href={route.href} class="about-route signal-marker">
						<span class="about-route__index" aria-hidden="true">0{index + 1}</span>
						<Icon name={route.icon} class="about-route__icon" />
						<span><strong>{route.name}</strong><small>{route.note}</small></span>
						<Icon name="material-symbols:arrow-outward-rounded" class="about-route__arrow" />
					</a>
				))}
			</nav>
		</section>

		<div class="about-content">
			<section id="welcome" class="about-section about-origin" aria-labelledby="welcome-title">
				<header class="about-section__header">
					<span class="about-section__number">01</span>
					<div>
						<span class="about-section__eyebrow">ORIGIN / 一切从哪里开始</span>
						<h2 id="welcome-title">欢迎你的到来！</h2>
					</div>
				</header>

				<div class="about-origin__grid">
					<figure class="about-postcard">
						<span class="about-postcard__tape" aria-hidden="true"></span>
						<Image src={asyaImage} alt="ASYA 向你说 Thank you" widths={[256, 384]} sizes="(max-width: 720px) 42vw, 15rem" />
						<figcaption>THANK YOU / FOR STOPPING BY</figcaption>
					</figure>

					<div class="about-prose about-prose--lead">
						<p class="about-lead"><strong>此网站用于记录生活、学习，更新时间不定（<del>我可能也懒得维护</del>）。</strong></p>
						<p>这个项目被搁置了太久太久了。最初想要做个博客是因为微光工作室的某一道招新题，我先用三件套构筑了一个还看得过去的博客（黑历史），后来尝试迁移到 Vue，后来在网上发现了好多新奇的框架，再后来尝试把一些自己写的组件重构到某些好用且优雅的博客框架里……</p>
						<blockquote class="about-quote">
							<span aria-hidden="true">“</span>
							<p>感觉实用性不大，只是为了好看而已。你对博客的热情也就仅限于你搭建博客的那几天，搭好了没两天就停更了，到最后就忘记有这么一回事了。</p>
							<cite>—— 偶然间在B站的教学视频下看到的评论</cite>
						</blockquote>
						<p>我想起刚入学那会儿，我搭好了人生的第一个博客，积极地配置了域名、购买了服务器，再在认识的圈子里宣传了一番，然后就没有下文了。阿里云后台的浏览量在短短几天之内归零，我也没再回去维护过我的网站。个人的小博客哪有流量，都是做给自己看的。</p>
						<p><strong>于是我开始反思</strong>：我的热情到底源于什么？是刚接触前端的新鲜感，是第一次看到别人的、漂亮的博客主题的惊叹与羡慕，还是单纯想要展示自己那半桶水的技术？</p>
					</div>
				</div>

				<div class="about-memory" aria-label="让我决定继续记录的片段">
					<article>
						<span>让我决定继续记录的片段 / 01</span>
						<h3>25工作室招新</h3>
						<p>我看着新生们交上来的招新题，想起去年为了做一个博客东奔西走讨教经验的自己，也想起刚加入工作室时满怀期待地找了几个队友、打了几场不那么优雅的比赛。虽然没什么拿得出手的成绩，但我觉得还是有所收获的。</p>
					</article>
					<article>
						<span>让我决定继续记录的片段 / 02</span>
						<h3>24年11月</h3>
						<p>我密谋许久，录下一段蹩脚的生日祝福。<br>点击发送之前，那段没来得及说再见的友谊和自以为结束了的青春，又在我的脑海里闪回。</p>
					</article>
					<article>
						<span>让我决定继续记录的片段 / 03</span>
						<h3>25年初</h3>
						<p>我遇见了我的小太阳，总是能找到我的优点，总是对我说：“你超级棒。” <br>也许生活没有我想象中的那么糟糕。</p>
					</article>
				</div>

				<div class="about-declaration">
					<span aria-hidden="true">→</span>
					<p>我想，趁着我还有这份热情与憧憬，我要开始做点什么了。</p>
					<time datetime="2025-10-12">2025.10.12</time>
				</div>
			</section>

			<section id="about-me" class="about-section" aria-labelledby="about-me-title">
				<header class="about-section__header">
					<span class="about-section__number">02</span>
					<div>
						<span class="about-section__eyebrow">PROFILE / 关于站长</span>
						<h2 id="about-me-title">关于我</h2>
					</div>
				</header>

				<div class="about-profile">
					<div class="about-profile__intro">
						<span class="about-profile__stamp">HUMAN / MAYBE</span>
						<p class="about-lead"><strong>半吊子前端，正在学习Agent...</strong></p>
						<p class="about-lead"><strong>随时可能陨落<del>(被限额)</del>的天才程序员</strong></p>
						<p>电科大自研哈吉米 3.5 Flash</p>
						<p>打字速度很慢  (真的很慢!)</p>
						<ul aria-label="个人关键词">
							<li>FRONTEND?</li>
							<li>AGENT</li>
							<li>SLOW TYPING</li>
						</ul>
					</div>

					<figure class="about-model-card">
						<figcaption>
							<span><b>MODEL TWIN / 性格映射</b><small>一张并不严肃的模型人格切片</small></span>
							<a href="https://api.reizeiin.xyz" target="_blank" rel="noopener noreferrer">来源：HUMANBENCH<Icon name="material-symbols:arrow-outward-rounded" /></a>
						</figcaption>
						<Image src={modelImage} alt="Gemini 3.5 Flash 模型能力雷达图" widths={[720, 1200, 1800]} sizes="(max-width: 720px) 100vw, 56vw" />
					</figure>
				</div>

				<div class="about-name-story">
					<div class="about-name-story__label">
						<span>CODENAME</span>
						<strong>Dr.Tonks?</strong>
						<small>既不是 Doctor，也不是 Tonks。</small>
					</div>
					<div class="about-prose">
						<p><strong>小时候特喜欢《哈利波特》，“Tonks” 的来源就是其中的唐克斯家（凤凰社安全屋）；</strong>Tonks 本身不是古老的纯血大家族，是反抗纯血主义的家庭，一边是麻瓜出身，一边是逃离布莱克家族的纯血女巫；整个家族是比较悲壮的，在第二次巫师战争承受巨大牺牲：父亲被搜捕队杀害；女儿唐克斯、女婿卢平死于霍格沃茨决战；只留下小儿子泰迪。</p>
						<p>后续染上了神秘博士，觉得 Dalek 和 Dr.WHO 老霸气了（不是剧情表现霸气，而是感觉念起来很霸气 hhh），遂在网名前添了个 Dr.</p>
						<p>虽然有先射箭后画靶的嫌疑，但是我依然希望自己能承载起这个名字所带来的意义；倒不是说非得有什么某某主义、反抗精神云云，也许只是在我快要放弃的时候，能够提醒我坚持创作、想起上网的初衷，在互联网上留下属于我的痕迹。</p>
						<p><strong>我正试着在第四次工业革命的浪潮里摸着石头过河。</strong></p>
					</div>
				</div>
			</section>

			<section class="about-home-link" aria-labelledby="home-link-title">
				<a href="https://tonks.top/" target="_blank" rel="noopener noreferrer" class="about-home-card">
					<div class="about-home-card__copy">
						<span>ANOTHER WINDOW / 个人主页</span>
						<h2 id="home-link-title">不只是博客</h2>
						<p>博客收藏过去，主页记录现在。</p>
						<p>来看看一些正在发生的事~</p>
						<strong>进入 tonks.top <Icon name="material-symbols:arrow-outward-rounded" /></strong>
					</div>
					<div class="about-home-card__preview" aria-hidden="true">
						<div class="about-browser-bar"><i></i><i></i><i></i><span>tonks.top</span></div>
						<img
							src={homePreviewSrc}
							data-local-fallback={homePreviewSrc !== homePreviewLocal ? homePreviewLocal : undefined}
							alt=""
							loading="lazy"
							decoding="async"
							draggable="false"
							onerror="this.onerror=null;const fallback=this.dataset.localFallback;if(fallback)this.src=fallback"
						/>
					</div>
				</a>
			</section>

			<section id="building" class="about-section about-build" aria-labelledby="building-title">
				<header class="about-section__header">
					<span class="about-section__number">03</span>
					<div>
						<span class="about-section__eyebrow">MAKING OF / 页面背后</span>
						<h2 id="building-title">关于本站的搭建</h2>
					</div>
				</header>

				<div class="about-build__intro">
					<div class="about-prose">
						<p>此网站使用 <strong>Astro</strong> 框架构建，基于 <a href="https://github.com/saicaca/fuwari" target="_blank" rel="noopener noreferrer">fuwari</a> 主题，参考其他同类型博客并深度魔改。虽然类似的主题已经烂大街了，它的布局还是能给我一种很清晰、很舒服的感觉，我很喜欢。</p>
						<p>Fuwari的视觉中心拿捏得很到位，柔和的过渡效果可能比较符合我的审美，因此参考并整合了Mizuki主题的波浪效果。也有尝试过一些科幻工业风格、后现代主义、极简风之类的主题，最后也还是回到了这里。</p>
					</div>
					<ul class="about-stack" aria-label="本站技术关键词">
						<li><span>CORE</span><strong>Astro</strong></li>
						<li><span>BASE</span><strong>Fuwari</strong></li>
						<li><span>STYLE</span><strong>4 Presets</strong></li>
						<li><span>STATE</span><strong>Still Growing</strong></li>
					</ul>
				</div>

				<div class="about-repositories prose dark:prose-invert !max-w-none">
					<article class="about-repository">
						<header><span>THANKS / 主题基础</span><p>特别感谢原作者及后续社区项目提供的基础设计与实现。</p></header>
						<GitHubRepoCard repo="saicaca/fuwari" />
					</article>
					<article class="about-repository">
						<header><span>SOURCE / 博客仓库</span><p>本站持续修改中的公开源代码与版本记录。</p></header>
						<GitHubRepoCard repo="DrTonks/tonks-blog" />
					</article>
				</div>
			</section>
		</div>
	</article>
	<CommunityComments page="about" />
</MainGridLayout>

<style>
	.about-shell {
		position: relative;
		width: 100%;
		overflow: hidden;
		color: rgba(0, 0, 0, 0.9);
		background: var(--card-bg);
	}

	:global(html.dark) .about-shell { color: rgba(255, 255, 255, 0.9); }

	.about-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
		gap: 1.35rem 2rem;
		padding: clamp(1.5rem, 3.2vw, 2.5rem);
		background:
			linear-gradient(90deg, color-mix(in srgb, currentColor 3.5%, transparent) 1px, transparent 1px),
			linear-gradient(color-mix(in srgb, currentColor 3.5%, transparent) 1px, transparent 1px),
			linear-gradient(135deg, color-mix(in srgb, var(--signal-soft) 30%, transparent), transparent 44%),
			var(--industrial-surface);
		background-size: 2rem 2rem, 2rem 2rem, auto, auto;
	}

	.about-hero::before { position: absolute; inset: 0 auto 0 0; width: 0.38rem; background: repeating-linear-gradient(to bottom, var(--signal-line) 0 0.32rem, transparent 0.32rem 0.62rem); content: ""; opacity: 0.78; }
	.about-hero::after { position: absolute; top: 0; right: 0; width: 3.2rem; height: 3.2rem; border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent); border-left: 1px solid color-mix(in srgb, currentColor 14%, transparent); background: var(--card-bg); clip-path: polygon(100% 0, 0 0, 100% 100%); content: ""; }
	.about-hero__register { position: absolute; top: 0.7rem; right: 3.75rem; color: color-mix(in srgb, currentColor 38%, transparent); font: 700 0.52rem/1 "JetBrains Mono Variable", monospace; letter-spacing: 0.12em; }
	.about-hero__copy { align-self: center; }
	.about-hero__title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: clamp(1rem, 3vw, 2.5rem); }
	.about-hero h1 { width: fit-content; margin: 0.7rem 0 0; font-size: clamp(2.8rem, 6vw, 4.8rem); line-height: 1; text-shadow: 0.18rem 0.18rem 0 color-mix(in srgb, currentColor 9%, transparent); }
	.about-hero__title-row p { max-width: 34rem; margin: 0.75rem 0 0; color: color-mix(in srgb, currentColor 66%, transparent); font-size: 0.92rem; line-height: 1.65; }
	.about-hero__coordinate { display: flex; gap: 1rem; margin-top: 1.25rem; color: color-mix(in srgb, currentColor 34%, transparent); font: 650 0.52rem/1 "JetBrains Mono Variable", monospace; letter-spacing: 0.1em; }

	.about-record { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-self: stretch; margin: 0; border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent); border-left: 1px solid var(--signal-line); }
	.about-record div { min-width: 0; padding: 0.85rem 0.95rem; border-right: 1px solid color-mix(in srgb, currentColor 10%, transparent); border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent); }
	.about-record dt, .about-section__eyebrow, .about-section__number, .about-memory article > span, .about-profile__stamp, .about-home-card__copy > span, .about-repository header span { color: var(--signal-line); font: 800 0.55rem/1.2 "JetBrains Mono Variable", monospace; letter-spacing: 0.12em; }
	.about-record dd { margin: 0.45rem 0 0; overflow: hidden; font-size: 0.8rem; font-weight: 750; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
	.about-record dd span { display: inline-block; width: 0.48rem; height: 0.48rem; margin-right: 0.4rem; border-radius: 999px; background: var(--primary); }

	.about-routes { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.65rem; }
	.about-route { position: relative; display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: center; gap: 0.65rem; min-width: 0; padding: 0.78rem 0.85rem; color: inherit; border: 1px solid color-mix(in srgb, var(--signal-line) 64%, currentColor 10%); background: color-mix(in srgb, var(--card-bg) 88%, transparent); clip-path: polygon(0 0, calc(100% - 0.65rem) 0, 100% 0.65rem, 100% 100%, 0 100%); transition: border-color var(--motion-signal-fast) ease, background-color var(--motion-signal-fast) ease, transform var(--motion-signal-fast) var(--ease-signal); }
	.about-route:hover, .about-route:focus-visible { border-color: var(--signal-line); background: color-mix(in srgb, var(--signal-soft) 42%, var(--card-bg)); transform: translateY(-0.12rem); }
	.about-route:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
	.about-route__index { color: color-mix(in srgb, currentColor 36%, transparent); font: 700 0.52rem/1 "JetBrains Mono Variable", monospace; }
	.about-route__icon { width: 1.05rem; color: var(--primary); }
	.about-route strong, .about-route small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.about-route strong { font-size: 0.82rem; }
	.about-route small { margin-top: 0.12rem; color: color-mix(in srgb, currentColor 50%, transparent); font-size: 0.65rem; }
	.about-route__arrow { width: 0.9rem; color: var(--signal-line); transition: transform var(--motion-signal-fast) var(--ease-signal); }
	.about-route:hover .about-route__arrow, .about-route:focus-visible .about-route__arrow { transform: translate(0.1rem, -0.1rem); }

	.about-content { padding: 0 clamp(1.35rem, 3vw, 2.4rem) clamp(1.5rem, 3vw, 2.6rem); }
	.about-section { position: relative; padding: clamp(2.4rem, 5vw, 4rem) 0; border-bottom: 1px dashed color-mix(in srgb, var(--signal-line) 38%, transparent); }
	.about-section__header { display: flex; align-items: flex-start; gap: 0.9rem; margin-bottom: clamp(1.5rem, 3vw, 2.2rem); }
	.about-section__number { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid var(--signal-line); background: color-mix(in srgb, var(--signal-soft) 45%, transparent); }
	.about-section h2 { margin: 0.35rem 0 0; font-size: clamp(1.55rem, 3.5vw, 2.35rem); font-weight: 780; line-height: 1.18; letter-spacing: -0.03em; }

	.about-origin__grid { display: grid; grid-template-columns: minmax(10rem, 0.34fr) minmax(0, 1fr); gap: clamp(1.6rem, 4vw, 3.2rem); align-items: start; }
	.about-postcard { position: sticky; top: 6.5rem; margin: 0.6rem 0 0; padding: 0.8rem 0.8rem 1.1rem; border: 1px solid color-mix(in srgb, currentColor 15%, transparent); background: color-mix(in srgb, var(--card-bg) 96%, white 4%); box-shadow: 0.45rem 0.55rem 0 color-mix(in srgb, currentColor 8%, transparent); transform: rotate(-2.2deg); }
	.about-postcard__tape { position: absolute; top: -0.75rem; left: 50%; width: 42%; height: 1.25rem; background: repeating-linear-gradient(135deg, color-mix(in srgb, currentColor 10%, transparent) 0 0.4rem, color-mix(in srgb, var(--card-bg) 72%, transparent) 0.4rem 0.8rem); transform: translateX(-50%) rotate(1.2deg); }
	.about-postcard :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; filter: saturate(0.88) contrast(1.03); }
	.about-postcard figcaption { margin-top: 0.85rem; color: color-mix(in srgb, currentColor 48%, transparent); font: 650 0.52rem/1.4 "JetBrains Mono Variable", monospace; letter-spacing: 0.08em; text-align: center; }

	.about-prose { color: color-mix(in srgb, currentColor 78%, transparent); font-size: 0.95rem; line-height: 1.95; }
	.about-prose p { margin: 0 0 1.15rem; }
	.about-prose p:last-child { margin-bottom: 0; }
