---
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
import type { AlbumGroup } from "../../../types/album";
import { scanAlbums } from "../../../utils/album-scanner";

export const getStaticPaths = async () => {
	const albumsData = await scanAlbums();
	return albumsData.map((album) => ({
		params: { id: album.id },
		props: { album },
	}));
};

interface Props {
	album: AlbumGroup;
}

const { album } = Astro.props;

if (!album) {
	return Astro.redirect("/404/");
}

const albumColumns = Number.isFinite(album.columns)
	? Math.min(6, Math.max(1, Math.floor(album.columns)))
	: 3;
const tabletAlbumColumns = Math.min(albumColumns, 2);

const useSurroundLayout = album.layout === "surround";
const effectiveLayout = useSurroundLayout
	? "surround"
	: album.layout === "masonry"
		? "masonry"
		: "grid";
const layoutClass = `${effectiveLayout}-layout`;

const normalizePhotoName = (value?: string) => value?.trim().toLowerCase();
const middlePhoto = useSurroundLayout
	? album.photos.find(
			(photo) =>
				normalizePhotoName(photo.title) === "middle" ||
				normalizePhotoName(photo.alt) === "middle",
		)
	: undefined;

const surroundStyles = new Map<string, string>();
const brickPattern = [
	"surround-feature",
	"surround-wide",
	"surround-tall",
	"surround-square",
	"surround-wide",
	"surround-square",
	"surround-tall",
	"surround-square",
];

if (useSurroundLayout && middlePhoto) {
	const surroundingPhotos = album.photos.filter(
		(photo) => photo.id !== middlePhoto.id,
	);
	const ringPhotos = surroundingPhotos.slice(0, 16);
	type RingSide = "top" | "right" | "bottom" | "left";
	const sideOrder: RingSide[] = ["top", "bottom", "right", "left"];
	const sideCounts: Record<RingSide, number> = {
		top: 0,
		right: 0,
		bottom: 0,
		left: 0,
	};

	// Four sides receive one photo first; remaining photos are distributed
	// symmetrically so every tile can expand into a neighbouring empty cell.
	ringPhotos.forEach((_, index) => {
		const side = sideOrder[index % sideOrder.length];
		sideCounts[side] += 1;
	});

	const photoRatio = (photo: (typeof ringPhotos)[number]) =>
		photo.width && photo.height ? photo.width / photo.height : 1;
	const sortedByRatio = [...ringPhotos].sort(
		(a, b) => photoRatio(b) - photoRatio(a),
	);
	const horizontalCount = sideCounts.top + sideCounts.bottom;
	const horizontalPhotos = sortedByRatio.slice(0, horizontalCount);
	const verticalPhotos = sortedByRatio
		.slice(horizontalCount)
		.sort((a, b) => photoRatio(a) - photoRatio(b));
	const photosBySide: Record<RingSide, typeof ringPhotos> = {
		top: horizontalPhotos.slice(0, sideCounts.top),
		bottom: horizontalPhotos.slice(
			sideCounts.top,
			sideCounts.top + sideCounts.bottom,
		),
		right: verticalPhotos.slice(0, sideCounts.right),
		left: verticalPhotos.slice(
			sideCounts.right,
			sideCounts.right + sideCounts.left,
		),
	};

	const splitTrack = (length: number, count: number) => {
		const base = Math.floor(length / count);
		const remainder = length % count;
		return Array.from(
			{ length: count },
			(_, index) => base + (index < remainder ? 1 : 0),
		);
	};

	const assignSide = (side: RingSide) => {
		const count = sideCounts[side];
		if (count === 0) return;
		const sidePhotos = photosBySide[side];

		if (side === "top" || side === "bottom") {
			let column = 1;
			const row = side === "top" ? 1 : 7;
			for (const [index, columnSpan] of splitTrack(8, count).entries()) {
				const photo = sidePhotos[index];
				surroundStyles.set(
					photo.id,
					`--brick-column-start: ${column}; --brick-column-span: ${columnSpan}; --brick-row-start: ${row}; --brick-row-span: 2;`,
				);
				column += columnSpan;
			}
			return;
		}

		const column = side === "left" ? 1 : 7;
		if (count === 2) {
			// Two tall bricks fill a side without forcing either image to be square.
			for (const [index, photo] of sidePhotos.entries()) {
				surroundStyles.set(
					photo.id,
					`--brick-column-start: ${column + index}; --brick-column-span: 1; --brick-row-start: 3; --brick-row-span: 4;`,
				);
			}
			return;
		}

		let row = 3;
		for (const [index, rowSpan] of splitTrack(4, count).entries()) {
			const photo = sidePhotos[index];
			surroundStyles.set(
				photo.id,
				`--brick-column-start: ${column}; --brick-column-span: 2; --brick-row-start: ${row}; --brick-row-span: ${rowSpan};`,
			);
			row += rowSpan;
		}
	};

	for (const side of sideOrder) assignSide(side);
}

const surroundClasses = new Map<string, string>();
if (useSurroundLayout) {
	album.photos.forEach((photo, index) => {
		if (photo.id === middlePhoto?.id) {
			surroundClasses.set(photo.id, "surround-middle");
		} else if (surroundStyles.has(photo.id)) {
			surroundClasses.set(photo.id, "surround-ring-item");
		} else {
			surroundClasses.set(photo.id, brickPattern[index % brickPattern.length]);
		}
	});
}
---

<MainGridLayout title={album.title} description={album.description || album.title}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      
      <!-- 返回按钮 -->
      <div class="mb-6">
        <a 
          href="/albums/" 
          class="inline-flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-[var(--primary)] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {i18n(I18nKey.albumsBackToList)}
        </a>
      </div>

      <!-- 相册标题信息 -->
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {album.title}
        </h1>
        
        {album.description && (
          <p class="text-neutral-600 dark:text-neutral-400 mb-4">
            {album.description}
          </p>
        )}
        
        <!-- 相册元数据 -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-500 dark:text-neutral-500">
          <span>{album.photos.length} {album.photos.length > 1 ? i18n(I18nKey.albumsPhotosCount) : i18n(I18nKey.albumsPhotoCount)}</span>
          <time>{new Date(album.date).toLocaleDateString('zh-CN')}</time>
          {album.location && (
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
              {album.location}
            </span>
          )}
        </div>
        
        <!-- 标签 -->
        {album.tags && album.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {album.tags.map(tag => (
              <span class="btn-regular h-8 text-sm px-3 rounded-lg">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- 照片网格 -->
      <div 
        class={`photo-gallery moment-images ${layoutClass}`}
        data-layout={effectiveLayout}
        data-requested-layout={album.layout}
        data-has-middle={middlePhoto ? "true" : "false"}
        data-columns={albumColumns}
        style={`--album-columns: ${albumColumns}; --album-tablet-columns: ${tabletAlbumColumns};`}
      >
        {album.photos.map((photo) => {
          const isMiddlePhoto = useSurroundLayout && photo.id === middlePhoto?.id;

          return (
          <figure
            class={`photo-item group relative overflow-hidden rounded-lg ${surroundClasses.get(photo.id) || ""}`}
            data-surround-role={useSurroundLayout ? (isMiddlePhoto ? "middle" : "brick") : undefined}
            style={useSurroundLayout && !isMiddlePhoto ? surroundStyles.get(photo.id) : undefined}
          >
            <a 
              href="javascript:void(0)"
              data-src={photo.src}
              data-fancybox="gallery"
              data-caption={photo.title || photo.alt}
              class="block"
            >
              <img 
                src={photo.src}
                alt={photo.alt}
                class="photo-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 cursor-pointer"
                loading="lazy"
              />
            </a>
          </figure>
          );
        })}
      </div>
    </div>
  </div>

</MainGridLayout>

<script>
  // 确保Fancybox正确处理相册图片
  document.addEventListener('DOMContentLoaded', () => {
    console.log('=== 相册页面加载完成 ===');
    
    // 检查页面中的图片元素
    const albumImages = document.querySelectorAll('.moment-images img, .photo-gallery img');
    console.log('相册图片数量:', albumImages.length);
    
    // 预加载图片以确保正确显示
    albumImages.forEach((img) => {
      if (img instanceof HTMLImageElement) {
        const preloadImg = new Image();
        preloadImg.src = img.src;
      }
    });
  });
</script>
