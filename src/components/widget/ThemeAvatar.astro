---
import { url } from "../../utils/url-utils";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { images: { light: string; dark: string } }
const { images } = Astro.props;
const localImages = import.meta.glob<ImageMetadata>(
  "../../assets/images/**/*.{png,jpg,jpeg,webp,avif}", { import: "default" },
);
async function avatarSource(path: string): Promise<string> {
  // Preserve public/remote URL support; only imported local assets are optimized.
  if (/^https?:\/\//.test(path)) return path;
  if (path.startsWith("/")) return url(path);
  const load = localImages[`../../${path}`];
  if (!load) throw new Error(`Theme avatar not found in src/assets/images: ${path}`);
  const source = await load();
  // 256 CSS px at DPR 2. Keep aspect ratio and never enlarge smaller originals.
  const width = Math.max(1, Math.round(source.width * Math.min(1, 512 / Math.max(source.width, source.height))));
  const optimized = await getImage({ src: source, width, format: "webp", quality: 80 });
  return optimized.src;
}
const [light, dark] = await Promise.all([avatarSource(images.light), avatarSource(images.dark)]);
---
<theme-avatar data-state="static">
  <img data-mode="light" src={light} alt="Profile Image of the Author" width="256" height="256" decoding="async" loading="eager" />
  <img data-mode="dark" src={dark} alt="Profile Image of the Author" width="256" height="256" decoding="async" loading="eager" />
  <canvas width="0" height="0" aria-hidden="true"></canvas>
</theme-avatar>
<style is:global>
  theme-avatar { display: block; position: relative; width: 100%; aspect-ratio: 1; contain: layout paint; }
  theme-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  theme-avatar img[data-mode="dark"] { visibility: hidden; }
  .dark theme-avatar img[data-mode="light"] { visibility: hidden; }
  .dark theme-avatar img[data-mode="dark"] { visibility: visible; }
  theme-avatar canvas { position: absolute; inset: 0; width: 100%; height: 100%; visibility: hidden; }
  theme-avatar[data-state="particles"] img { visibility: hidden !important; }
  theme-avatar[data-state="particles"] canvas { visibility: visible; }
  ::view-transition-group(theme-avatar) { z-index: 2; animation: none; }
  ::view-transition-new(theme-avatar) { animation: none; mix-blend-mode: normal; z-index: 1; clip-path: circle(0px); }
</style>
<script>
  import { ThemeAvatarElement } from "../../utils/theme-avatar";
  if (!customElements.get("theme-avatar")) customElements.define("theme-avatar", ThemeAvatarElement);
</script>
