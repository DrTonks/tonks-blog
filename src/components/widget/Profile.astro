---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { profileLinkAttributes, url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
import TypewriterText from "../TypewriterText.astro";
import ProfileSignature from "../ProfileSignature.astro";
import ThemeAvatar from "./ThemeAvatar.astro";
---

<div class="card-base p-3 font-hanalei">
	<div data-avatar-composite>
		<a
			aria-label="Go to About Page"
			href={url("/about/")}
			class="profile-avatar group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95"
		>
			<div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50 w-full h-full z-50 flex items-center justify-center">
				<Icon name="fa6-regular:address-card" class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl" />
			</div>
			{profileConfig.themeAvatars ? <ThemeAvatar images={profileConfig.themeAvatars} /> : <ImageWrapper
				src={profileConfig.avatar || ""}
				alt="Profile Image of the Author"
				class="mx-auto lg:w-full h-full lg:mt-0"
				loading="eager"
				decoding="async"
				fetchpriority="auto"
			/>}
		</a>
		<ProfileSignature />
	</div>
	<div class="px-2">
		<div class="text-center text-neutral-400 mb-2.5 transition">
			{profileConfig.typewriter?.enable ? (
				<TypewriterText
					text={profileConfig.bio ?? ""}
					speed={profileConfig.typewriter.speed}
					class="inline-block"
				/>
			) : profileConfig.bio}
		</div>
		<div class="flex gap-2 justify-center mb-1">
			{profileConfig.links.map((item) => item.action === "copy-rss" ? (
				<button type="button" data-copy-rss={new URL(item.url, Astro.site).href} aria-label="复制 RSS 订阅地址" title="复制 RSS 订阅地址" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
					<span class="rss-copy-icon" aria-hidden="true"><Icon name={item.icon} class="text-[1.5rem]" /></span>
					<span class="rss-copied-icon" aria-hidden="true"><Icon name="material-symbols:check-rounded" class="text-[1.5rem]" /></span>
				</button>
			) : (
				<a {...profileLinkAttributes(item, Astro.site!)} aria-label={item.name} href={item.url} class:list={["btn-regular rounded-lg h-10 active:scale-90", profileConfig.links.length === 1 ? "gap-2 px-3 font-bold" : "w-10"]}>
					<Icon name={item.icon} class="text-[1.5rem]" />
					{profileConfig.links.length === 1 && item.name}
				</a>
			))}

		</div>
		<p data-rss-feedback role="status" class="rss-feedback sr-only"></p>
	</div>
</div>

<script>
	import "../../scripts/copy-rss";
</script>

<style>
	.rss-feedback:not(.sr-only) { font-family: system-ui, sans-serif; font-size: .75rem; line-height: 1.5; overflow-wrap: anywhere; color: var(--text-secondary); text-align: center; margin-top: .5rem; }
	.rss-copy-icon { display: flex; }
	.rss-copied-icon { display: none; }
	[data-copy-state="copied"] .rss-copy-icon { display: none; }
	[data-copy-state="copied"] .rss-copied-icon { display: flex; }
	button[data-copy-state="copied"] { background: var(--primary); color: var(--deep-text); }
	/* Keep the avatar's z-50 hover overlay below the sibling signature (z-index: 1). */
	.profile-avatar { z-index: 0; }
	.profile-avatar::after {
		content: "";
		position: absolute;
		inset: auto 0 0;
		height: 24%;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--card-bg) 55%, transparent) 55%, var(--card-bg));
	}
</style>
