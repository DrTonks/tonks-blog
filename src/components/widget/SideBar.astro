---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { widgetManager } from "../../utils/widget-manager";
import Announcement from "./Announcement.astro";
import AISummary from "./AISummary.astro";
import SidebarPrimaryWidget from "./SidebarPrimaryWidget.astro";
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.svelte";
import Profile from "./Profile.astro";
import Tags from "./Tags.astro";
import TOC from "./TOC.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	aiSummary?: { slug: string; summary: string };
}

const { class: className, headings, aiSummary } = Astro.props;

// 获取配置的组件列表
const topComponents = widgetManager.getComponentsByPosition("top");
const stickyComponents = widgetManager.getComponentsByPosition("sticky");
const showSidebarToc = Boolean(siteConfig.toc.enable && headings?.length);

// 组件映射表
const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	toc: TOC,
	"music-player": MusicPlayer,
};

// 渲染组件的辅助函数
function renderComponent(component: any, index: number, _components: any[]) {
	const ComponentToRender =
		componentMap[component.type as keyof typeof componentMap];
	if (!ComponentToRender) return null;

	const componentClass = widgetManager.getComponentClass(component, index);
	const componentStyle = widgetManager.getComponentStyle(component, index);

	return {
		Component: ComponentToRender,
		props: {
			class: componentClass,
			style: componentStyle,
			headings: component.type === "toc" ? headings : undefined,
			...component.customProps,
		},
	};
}
---

<div id="sidebar" class:list={[className, "w-full",   {
	"sidebar-article-mode": Boolean(aiSummary),
	"sidebar-has-inline-toc": siteConfig.toc.enable,
	"sidebar-inline-active": showSidebarToc,
}]}>
	<!-- 顶部固定组件区域 -->
	{topComponents.length > 0 && (
		<div class="sidebar-top-components flex flex-col w-full gap-4 mb-4">
			{topComponents.map((component, index) => {
				const renderData = renderComponent(component, index, topComponents);
				if (!renderData) return null;
				
				const { Component, props } = renderData;
				if (component.type === "profile") {
					return <>
						<SidebarPrimaryWidget mode={aiSummary ? "summary" : "profile"}>
							<Profile slot="profile" {...props} />
							<AISummary slot="summary" summary={aiSummary?.summary} />
						</SidebarPrimaryWidget>
						{siteConfig.toc.enable && <div class="sidebar-inline-toc hidden md:block" hidden={!showSidebarToc} data-sidebar-motion-item>
							<WidgetLayout id="sidebar-toc-card" name={i18n(I18nKey.tableOfContents)} titleClass="font-hanalei">
								<button slot="title-action" type="button" class="sidebar-collapse-toggle" data-sidebar-toc-toggle aria-expanded="true" aria-controls="sidebar-toc-card" aria-label="收起目录" title="收起目录">
									<Icon name="material-symbols:keyboard-arrow-up-rounded" class="sidebar-collapse-toggle__icon" />
								</button>
								<div class="sidebar-inline-toc__viewport">
									<TOC id="sidebar-toc" headings={headings ?? []} />
								</div>
							</WidgetLayout>
						</div>}
					</>;
				}
				return <div data-sidebar-motion-item><Component {...props} /></div>;
			})}
		</div>
	)}
	
	<!-- 粘性组件区域 -->
	{stickyComponents.length > 0 && (
		<div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 sticky top-0">
			{stickyComponents.map((component, index) => {
				const renderData = renderComponent(component, index, stickyComponents);
				if (!renderData) return null;
				
				const { Component, props } = renderData;
				return <div data-sidebar-motion-item><Component {...props} /></div>;
			})}
		</div>
	)}
</div>

<!-- 响应式样式和JavaScript -->
<style>

	/* 响应式断点样式 */
	@media (max-width: 768px) {
		#sidebar {
			display: var(--sidebar-mobile-display, block);
		}
	}
	
	@media (min-width: 769px) and (max-width: 1024px) {
		#sidebar {
			display: var(--sidebar-tablet-display, block);
		}
	}
	
	@media (min-width: 1025px) {
		#sidebar {
			display: var(--sidebar-desktop-display, block);
		}
	}

	@media (min-width: 769px) {
		#sidebar.sidebar-article-mode {
			position: sticky;
			top: 0.75rem;
			align-self: start;
		}

		#sidebar.sidebar-article-mode.sidebar-sticky-released {
			position: relative;
			top: var(--sidebar-release-offset, 0px);
		}

		#sidebar.sidebar-article-mode #sidebar-sticky {
			position: static;
		}
	}

	[data-sidebar-motion-item] {
		display: block;
		width: 100%;
		will-change: auto;
	}

	[data-sidebar-motion-item][hidden] {
		display: none;
	}

	[data-sidebar-motion-item] > :global(widget-layout) {
		display: flow-root;
		width: 100%;
	}

	.sidebar-inline-toc {
		position: static;
		z-index: 1;
		opacity: 1;
		transform: translateY(0);
		transition: opacity 180ms ease, transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.sidebar-inline-toc.is-revealing {
		opacity: 0;
		transform: translateY(0.5rem);
	}

	.sidebar-inline-toc[hidden] {
		display: none !important;
	}

	/* The scoped motion-item rule is more specific than Tailwind's responsive
	   display utilities, so enforce the inline TOC's actual viewport range. */
	@media (max-width: 767px), (min-width: 1728px) {
		#sidebar .sidebar-inline-toc {
			display: none !important;
		}
	}

	.sidebar-inline-toc__viewport {
		max-height: clamp(16rem, calc(100vh - 22rem), 36rem);
		overflow: hidden;
		transition: max-height 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.sidebar-inline-toc.is-collapsed .sidebar-inline-toc__viewport {
		max-height: 9rem;
	}

	.sidebar-collapse-toggle {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		margin-left: auto;
		place-items: center;
		border: 1px solid color-mix(in oklch, var(--primary) 24%, transparent);
		border-radius: 0.75rem;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		cursor: pointer;
		transition: background-color 180ms ease, border-color 180ms ease, transform 120ms ease;
	}

	.sidebar-collapse-toggle:hover {
		border-color: color-mix(in oklch, var(--primary) 46%, transparent);
		background: color-mix(in oklch, var(--primary) 18%, transparent);
	}

	.sidebar-collapse-toggle:active { transform: scale(0.94); }
	.sidebar-collapse-toggle:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
	.sidebar-collapse-toggle__icon { font-size: 1.4rem; transition: transform 220ms ease; }
	.sidebar-collapse-toggle[aria-expanded="false"] .sidebar-collapse-toggle__icon { transform: rotate(180deg); }

	.sidebar-inline-toc__viewport :global(table-of-contents) {
		height: auto;
		max-height: inherit;
		overflow-y: auto;
		padding-bottom: 0.5rem;
	}

	/* Flatten the top group only while the inline TOC is active. This makes the
	   TOC's sticky containing block the whole sidebar instead of the short top
	   group, so it can remain sticky until the sidebar/article release point. */
	@media (min-width: 768px) and (max-width: 1727px) {
		#sidebar.sidebar-has-inline-toc {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		#sidebar.sidebar-has-inline-toc > .sidebar-top-components {
			display: contents;
		}

		/* Move as one unit: profile, TOC, announcement, categories and tags.
		   The grid row bounds native sticky at the article bottom. */
		#sidebar.sidebar-inline-active {
			position: sticky;
			top: 0.75rem;
			align-self: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sidebar-inline-toc__viewport,
		.sidebar-collapse-toggle__icon {
			transition: none;
		}
	}
</style>

<script>
    import { syncPrimaryWidget } from "../../scripts/sidebar-primary";
	import { widgetManager } from "../../utils/widget-manager";
	
	type SidebarWindow = Window & {
		__sidebarResponsiveInitialized?: boolean;
		__aiSummarySidebarInitialized?: boolean;
		__aiSummaryRun?: number;
		__articleSidebarStickyInitialized?: boolean;
	};

	const sidebarWindow = window as SidebarWindow;

	function updateResponsiveDisplay() {
		const breakpoints = widgetManager.getBreakpoints();
		const width = window.innerWidth;

		let deviceType: "mobile" | "tablet" | "desktop";
		if (width < breakpoints.mobile) {
			deviceType = "mobile";
		} else if (width < breakpoints.tablet) {
			deviceType = "tablet";
		} else {
			deviceType = "desktop";
		}

		const shouldShow = widgetManager.shouldShowSidebar(deviceType);
		const sidebar = document.getElementById("sidebar");

		sidebar?.style.setProperty(
			`--sidebar-${deviceType}-display`,
			shouldShow ? "block" : "none",
		);
	}

	updateResponsiveDisplay();

	if (!sidebarWindow.__sidebarResponsiveInitialized) {
		sidebarWindow.__sidebarResponsiveInitialized = true;
		window.addEventListener("resize", updateResponsiveDisplay, { passive: true });
	}


	let summaryToggleFrame = 0;
	let tocToggleFrame = 0;
	let stickyFrame = 0;
	let inlineTocFrame = 0;
	function syncArticleSidebarSticky(reset = false) {
		const sidebar = document.getElementById("sidebar");
		const article = document.getElementById("content-wrapper");
		const isArticle = Boolean(document.getElementById("ai-summary-data"));
		if (!sidebar || !article || !isArticle || window.innerWidth < 769) {
			sidebar?.classList.remove("sidebar-sticky-released");
			sidebar?.style.removeProperty("--sidebar-release-offset");
			return;
		}

		// 左侧目录模式保持整个侧栏 sticky，不触发半程释放。
		if (sidebar.classList.contains("sidebar-inline-active")) {
			sidebar.classList.remove("sidebar-sticky-released");
			sidebar.style.removeProperty("--sidebar-release-offset");
			return;
		}

		if (reset) {
			sidebar.classList.remove("sidebar-sticky-released");
			sidebar.style.removeProperty("--sidebar-release-offset");
			const grid = document.getElementById("main-grid");
			sidebar.dataset.stickyNaturalTop = String((grid || sidebar).getBoundingClientRect().top + window.scrollY);
		}
		const articleTop = article.getBoundingClientRect().top + window.scrollY;
		const releaseAt = articleTop + article.offsetHeight * 0.5;
		const naturalTop = Number(sidebar.dataset.stickyNaturalTop || articleTop);
		if (window.scrollY >= releaseAt) {
			sidebar.style.setProperty("--sidebar-release-offset", `${Math.max(0, releaseAt - naturalTop + 12)}px`);
			sidebar.classList.add("sidebar-sticky-released");
		} else {
			sidebar.classList.remove("sidebar-sticky-released");
		}
	}

	function scheduleArticleSidebarSticky(reset = false) {
		if (stickyFrame) cancelAnimationFrame(stickyFrame);
		stickyFrame = requestAnimationFrame(() => {
			stickyFrame = 0;
			syncArticleSidebarSticky(reset);
		});
	}

	function scheduleInlineTocSync() {
		if (inlineTocFrame) cancelAnimationFrame(inlineTocFrame);
		inlineTocFrame = requestAnimationFrame(() => {
			inlineTocFrame = 0;
			syncInlineToc();
		});
	}

	function syncInlineToc() {
		const sidebar = document.getElementById("sidebar");
		const inlineToc = sidebar?.querySelector<HTMLElement>(".sidebar-inline-toc");
		const toc = inlineToc?.querySelector<HTMLElement & { syncTracking?: (force?: boolean) => void }>("table-of-contents");
		if (!sidebar || !inlineToc) return;

		const contentRoot = document.querySelector(".custom-md, .markdown-content, .prose");
		const hasArticleHeadings = Boolean(contentRoot?.querySelector("h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]"));
		const inlineViewportActive = window.matchMedia("(min-width: 768px) and (max-width: 1727px)").matches;
		const shouldShowInlineToc = hasArticleHeadings && inlineViewportActive;
		inlineToc.hidden = !shouldShowInlineToc;
		inlineToc.classList.remove("is-revealing");
		sidebar.classList.toggle("sidebar-inline-active", shouldShowInlineToc);
		// content:replace 已经重建目录；page:view 只切换可见实例的跟踪权。
		toc?.syncTracking?.(true);
		scheduleArticleSidebarSticky(true);
	}

	function initSidebarTocToggle() {
		const sidebar = document.getElementById("sidebar");
		const inlineToc = sidebar?.querySelector<HTMLElement>(".sidebar-inline-toc");
		const toggle = inlineToc?.querySelector<HTMLButtonElement>("[data-sidebar-toc-toggle]");
		if (!inlineToc || !toggle) return;
		const hasTwoTocInstances = document.querySelectorAll("table-of-contents").length > 1;
		if (hasTwoTocInstances && toggle.dataset.userToggled !== "true") {
			inlineToc.classList.add("is-collapsed");
			toggle.setAttribute("aria-expanded", "false");
			toggle.setAttribute("aria-label", "展开目录");
			toggle.title = "展开目录";
		}
		if (toggle.dataset.initialized === "true") return;
		toggle.dataset.initialized = "true";
		toggle.addEventListener("click", () => {
			toggle.dataset.userToggled = "true";
			const collapsed = !inlineToc.classList.contains("is-collapsed");
			const viewport = inlineToc.querySelector<HTMLElement>(".sidebar-inline-toc__viewport");
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (viewport && !reduceMotion) {
				const startHeight = viewport.getBoundingClientRect().height;
				viewport.style.transition = "none";
				viewport.style.maxHeight = "none";
				inlineToc.classList.toggle("is-collapsed", collapsed);
				const expandedLimit = Math.max(256, window.innerHeight - 352);
				const endHeight = collapsed
					? 144
					: Math.min(viewport.scrollHeight, 576, expandedLimit);
				viewport.style.maxHeight = `${startHeight}px`;
				viewport.getBoundingClientRect();
				viewport.style.removeProperty("transition");
				tocToggleFrame = requestAnimationFrame(() => {
					tocToggleFrame = 0;
					viewport.style.maxHeight = `${endHeight}px`;
				});
				viewport.addEventListener("transitionend", (event) => {
					if (event.propertyName === "max-height") viewport.style.removeProperty("max-height");
				}, { once: true });
			} else {
				inlineToc.classList.toggle("is-collapsed", collapsed);
			}
			toggle.setAttribute("aria-expanded", String(!collapsed));
			toggle.setAttribute("aria-label", collapsed ? "展开目录" : "收起目录");
			toggle.title = collapsed ? "展开目录" : "收起目录";
		});
	}

	function initAISummaryToggle() {
		const card = document.querySelector<HTMLElement>(".ai-summary-card");
		const toggle = card?.querySelector<HTMLButtonElement>("[data-ai-summary-toggle]");
		if (!card || !toggle || toggle.dataset.initialized === "true") return;
		toggle.dataset.initialized = "true";
			toggle.addEventListener("click", () => {
			const collapsed = !card.classList.contains("is-collapsed");
			const content = card.querySelector<HTMLElement>("#ai-summary-content");
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const startHeight = content?.getBoundingClientRect().height || 0;
			if (content) {
				content.style.transition = "none";
				content.style.height = "auto";
			}
			card.classList.toggle("is-collapsed", collapsed);
			if (content) {
				const endHeight = content.getBoundingClientRect().height;
				if (reduceMotion) {
					content.style.removeProperty("height");
					content.style.removeProperty("transition");
				} else {
					content.style.height = `${startHeight}px`;
					content.getBoundingClientRect();
					content.style.removeProperty("transition");
					summaryToggleFrame = requestAnimationFrame(() => { summaryToggleFrame = 0; content.style.height = `${endHeight}px`; });
					content.addEventListener("transitionend", (event) => {
						if (event.propertyName === "height") content.style.removeProperty("height");
					}, { once: true });
				}
			}
			toggle.setAttribute("aria-expanded", String(!collapsed));
			toggle.setAttribute("aria-label", collapsed ? "展开 AI 摘要" : "收起 AI 摘要");
			toggle.title = collapsed ? "展开 AI 摘要" : "收起 AI 摘要";
		});
	}

	if (!sidebarWindow.__articleSidebarStickyInitialized) {
		sidebarWindow.__articleSidebarStickyInitialized = true;
		window.addEventListener("scroll", () => scheduleArticleSidebarSticky(false), { passive: true });
		window.addEventListener("resize", () => {
			scheduleInlineTocSync();
			scheduleArticleSidebarSticky(true);
		}, { passive: true });
	}

	const syncAISummary = syncPrimaryWidget;

	// Populate and position the persistent sidebar while the incoming page is
	// still hidden. No FLIP offsets may span two different window scroll positions.
	function settleSidebar() {
        cancelAnimationFrame(summaryToggleFrame);
        cancelAnimationFrame(tocToggleFrame);
        summaryToggleFrame = tocToggleFrame = 0;
        for (const element of document.querySelectorAll<HTMLElement>("#ai-summary-content, .sidebar-inline-toc__viewport")) {
            element.style.removeProperty("height");
            element.style.removeProperty("max-height");
            element.style.removeProperty("transition");
        }
		initSidebarTocToggle();
		initAISummaryToggle();
		syncAISummary();
		syncInlineToc();
		if (stickyFrame) { cancelAnimationFrame(stickyFrame); stickyFrame = 0; }
		syncArticleSidebarSticky(true);
		document.querySelectorAll<HTMLElement & { settleForNavigation?: () => void }>("table-of-contents").forEach(toc => toc.settleForNavigation?.());
	}

	if (!sidebarWindow.__aiSummarySidebarInitialized) {
		sidebarWindow.__aiSummarySidebarInitialized = true;
		const registerSwup = () => {

			window.swup?.hooks?.on("content:replace", settleSidebar);
			window.swup?.hooks?.on("content:scroll", settleSidebar);
			window.swup?.hooks?.before("animation:in:start", settleSidebar);

		};
		if (window.swup) registerSwup();
		else document.addEventListener("swup:enable", registerSwup, { once: true });
	}
	requestAnimationFrame(() => {
		initSidebarTocToggle();
		initAISummaryToggle();
		syncInlineToc();
		syncAISummary();
        const host = document.getElementById('sidebar-primary-widget');
        if (host) delete host.dataset.animateContent;
	});
</script>

