---
import type { MarkdownHeading } from "astro";
import { widgetManager } from "../../utils/widget-manager";
import Announcement from "./Announcement.astro";
import AISummary from "./AISummary.astro";
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.svelte";
import Profile from "./Profile.astro";
import Tags from "./Tags.astro";
import TOC from "./TOC.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	aiSummary?: { slug: string; summary: string };
}

const { class: className, headings, aiSummary } = Astro.props;

// 获取配置的组件列表
const topComponents = widgetManager.getComponentsByPosition("top");
const stickyComponents = widgetManager.getComponentsByPosition("sticky");

// 组件映射表
const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	toc: TOC,
	"music-player": MusicPlayer,
};

// 渲染组件的辅助函数
function renderComponent(component: any, index: number, _components: any[]) {
	const ComponentToRender =
		componentMap[component.type as keyof typeof componentMap];
	if (!ComponentToRender) return null;

	const componentClass = widgetManager.getComponentClass(component, index);
	const componentStyle = widgetManager.getComponentStyle(component, index);

	return {
		Component: ComponentToRender,
		props: {
			class: componentClass,
			style: componentStyle,
			headings: component.type === "toc" ? headings : undefined,
			...component.customProps,
		},
	};
}
---

<div id="sidebar" class:list={[className, "w-full", { "sidebar-article-mode": Boolean(aiSummary) }]}>
	<!-- 顶部固定组件区域 -->
	{topComponents.length > 0 && (
		<div class="flex flex-col w-full gap-4 mb-4">
			{topComponents.map((component, index) => {
				const renderData = renderComponent(component, index, topComponents);
				if (!renderData) return null;
				
				const { Component, props } = renderData;
				if (component.type === "profile") {
					return <div id="sidebar-primary-widget" data-sidebar-motion-item data-mode={aiSummary ? "summary" : "profile"}>
						<div data-sidebar-profile-panel hidden={Boolean(aiSummary)}><Profile {...props} /></div>
						<div data-sidebar-summary-panel hidden={!aiSummary}><AISummary summary={aiSummary?.summary} /></div>
					</div>;
				}
				return <div data-sidebar-motion-item><Component {...props} /></div>;
			})}
		</div>
	)}
	
	<!-- 粘性组件区域 -->
	{stickyComponents.length > 0 && (
		<div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 sticky top-0">
			{stickyComponents.map((component, index) => {
				const renderData = renderComponent(component, index, stickyComponents);
				if (!renderData) return null;
				
				const { Component, props } = renderData;
				return <div data-sidebar-motion-item><Component {...props} /></div>;
			})}
		</div>
	)}
</div>

<!-- 响应式样式和JavaScript -->
<style>
	/* 响应式断点样式 */
	@media (max-width: 768px) {
		#sidebar {
			display: var(--sidebar-mobile-display, block);
		}
	}
	
	@media (min-width: 769px) and (max-width: 1024px) {
		#sidebar {
			display: var(--sidebar-tablet-display, block);
		}
	}
	
	@media (min-width: 1025px) {
		#sidebar {
			display: var(--sidebar-desktop-display, block);
		}
	}

	@media (min-width: 769px) {
		#sidebar.sidebar-article-mode {
			position: sticky;
			top: 0.75rem;
			align-self: start;
		}

		#sidebar.sidebar-article-mode.sidebar-sticky-released {
			position: relative;
			top: var(--sidebar-release-offset, 0px);
		}

		#sidebar.sidebar-article-mode #sidebar-sticky {
			position: static;
		}
	}

	#sidebar-primary-widget [data-sidebar-profile-panel],
	#sidebar-primary-widget [data-sidebar-summary-panel] {
		transform: translateY(0) scale(1);
		opacity: 1;
		transition: opacity 180ms ease, transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	#sidebar-primary-widget .is-leaving {
		transform: translateY(-0.45rem) scale(0.985);
		opacity: 0;
	}

	#sidebar-primary-widget .is-entering {
		transform: translateY(0.55rem) scale(0.985);
		opacity: 0;
	}

	[data-sidebar-motion-item] {
		display: block;
		width: 100%;
		will-change: auto;
	}

	[data-sidebar-motion-item][hidden] {
		display: none;
	}

	[data-sidebar-motion-item] > :global(widget-layout) {
		display: flow-root;
		width: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		#sidebar-primary-widget [data-sidebar-profile-panel],
		#sidebar-primary-widget [data-sidebar-summary-panel] {
			transition: none;
		}
	}
</style>

<script>
	import { widgetManager } from "../../utils/widget-manager";
	
	type SidebarWindow = Window & {
		__sidebarResponsiveInitialized?: boolean;
		__aiSummarySidebarInitialized?: boolean;
		__aiSummaryRun?: number;
		__articleSidebarStickyInitialized?: boolean;
	};

	const sidebarWindow = window as SidebarWindow;

	function updateResponsiveDisplay() {
		const breakpoints = widgetManager.getBreakpoints();
		const width = window.innerWidth;

		let deviceType: "mobile" | "tablet" | "desktop";
		if (width < breakpoints.mobile) {
			deviceType = "mobile";
		} else if (width < breakpoints.tablet) {
			deviceType = "tablet";
		} else {
			deviceType = "desktop";
		}

		const shouldShow = widgetManager.shouldShowSidebar(deviceType);
		const sidebar = document.getElementById("sidebar");

		sidebar?.style.setProperty(
			`--sidebar-${deviceType}-display`,
			shouldShow ? "block" : "none",
		);
	}

	updateResponsiveDisplay();

	if (!sidebarWindow.__sidebarResponsiveInitialized) {
		sidebarWindow.__sidebarResponsiveInitialized = true;
		window.addEventListener("resize", updateResponsiveDisplay, { passive: true });
	}

	const wait = (duration: number) => new Promise<void>((resolve) => window.setTimeout(resolve, duration));

	let stickyFrame = 0;
	function syncArticleSidebarSticky(reset = false) {
		const sidebar = document.getElementById("sidebar");
		const article = document.getElementById("content-wrapper");
		const isArticle = Boolean(document.getElementById("ai-summary-data"));
		if (!sidebar || !article || !isArticle || window.innerWidth < 769) {
			sidebar?.classList.remove("sidebar-sticky-released");
			sidebar?.style.removeProperty("--sidebar-release-offset");
			return;
		}

		if (reset) {
			sidebar.classList.remove("sidebar-sticky-released");
			sidebar.style.removeProperty("--sidebar-release-offset");
			const grid = document.getElementById("main-grid");
			sidebar.dataset.stickyNaturalTop = String((grid || sidebar).getBoundingClientRect().top + window.scrollY);
		}
		const articleTop = article.getBoundingClientRect().top + window.scrollY;
		const releaseAt = articleTop + article.offsetHeight * 0.5;
		const naturalTop = Number(sidebar.dataset.stickyNaturalTop || articleTop);
		if (window.scrollY >= releaseAt) {
			sidebar.style.setProperty("--sidebar-release-offset", `${Math.max(0, releaseAt - naturalTop + 12)}px`);
			sidebar.classList.add("sidebar-sticky-released");
		} else {
			sidebar.classList.remove("sidebar-sticky-released");
		}
	}

	function scheduleArticleSidebarSticky(reset = false) {
		if (stickyFrame) cancelAnimationFrame(stickyFrame);
		stickyFrame = requestAnimationFrame(() => {
			stickyFrame = 0;
			syncArticleSidebarSticky(reset);
		});
	}

	if (!sidebarWindow.__articleSidebarStickyInitialized) {
		sidebarWindow.__articleSidebarStickyInitialized = true;
		window.addEventListener("scroll", () => scheduleArticleSidebarSticky(false), { passive: true });
		window.addEventListener("resize", () => scheduleArticleSidebarSticky(true), { passive: true });
	}

	function typeSummary(summary: string, run: number) {
		const card = document.querySelector<HTMLElement>(".ai-summary-card");
		const visual = card?.querySelector<HTMLElement>("[data-ai-summary-visual]");
		const accessible = card?.querySelector<HTMLElement>("[data-ai-summary-accessible]");
		const count = card?.querySelector<HTMLElement>("[data-ai-summary-count]");
		if (!card || !visual || !accessible || !count) return;

		const characters = Array.from(summary).slice(0, 181);
		accessible.textContent = summary;
		count.textContent = "0 字";
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			visual.textContent = summary;
			count.textContent = `${characters.length} 字`;
			return;
		}

		visual.textContent = "";
		card.classList.add("is-typing");
		const startedAt = performance.now();
		const step = (now: number) => {
			if (sidebarWindow.__aiSummaryRun !== run) return;
			const visibleCount = Math.min(characters.length, Math.floor((now - startedAt) / 24));
			visual.textContent = characters.slice(0, visibleCount).join("");
			count.textContent = `${visibleCount} 字`;
			if (visibleCount < characters.length) requestAnimationFrame(step);
			else card.classList.remove("is-typing");
		};
		requestAnimationFrame(step);
	}

	async function syncAISummary(initial = false) {
		const host = document.getElementById("sidebar-primary-widget");
		const sidebar = document.getElementById("sidebar");
		const profilePanel = host?.querySelector<HTMLElement>("[data-sidebar-profile-panel]");
		const summaryPanel = host?.querySelector<HTMLElement>("[data-sidebar-summary-panel]");
		if (!host || !sidebar || !profilePanel || !summaryPanel) return;

		const payload = document.getElementById("ai-summary-data") as HTMLElement | null;
		const summary = payload?.dataset.summary || "";
		const nextMode = payload ? "summary" : "profile";
		const currentMode = host.dataset.mode || "profile";
		const run = (sidebarWindow.__aiSummaryRun || 0) + 1;
		sidebarWindow.__aiSummaryRun = run;

		if (initial || currentMode === nextMode) {
			host.dataset.mode = nextMode;
			profilePanel.hidden = nextMode !== "profile";
			summaryPanel.hidden = nextMode !== "summary";
			sidebar.classList.toggle("sidebar-article-mode", nextMode === "summary");
			if (nextMode === "summary") typeSummary(summary, run);
			scheduleArticleSidebarSticky(true);
			return;
		}

		const movingItems = [...sidebar.querySelectorAll<HTMLElement>("[data-sidebar-motion-item]")].slice(1);
		const before = new Map(movingItems.map((item) => [item, item.getBoundingClientRect().top]));
		const currentPanel = currentMode === "summary" ? summaryPanel : profilePanel;
		const nextPanel = nextMode === "summary" ? summaryPanel : profilePanel;
		currentPanel.classList.add("is-leaving");
		await wait(150);
		if (sidebarWindow.__aiSummaryRun !== run) return;

		currentPanel.hidden = true;
		currentPanel.classList.remove("is-leaving");
		nextPanel.classList.add("is-entering");
		nextPanel.hidden = false;
		host.dataset.mode = nextMode;
		sidebar.classList.toggle("sidebar-article-mode", nextMode === "summary");

		for (const item of movingItems) {
			const delta = (before.get(item) || 0) - item.getBoundingClientRect().top;
			if (!delta) continue;
			item.style.transition = "none";
			item.style.transform = `translateY(${delta}px)`;
		}
		requestAnimationFrame(() => requestAnimationFrame(() => {
			nextPanel.classList.remove("is-entering");
			for (const item of movingItems) {
				item.style.transition = "transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1)";
				item.style.transform = "translateY(0)";
			}
		}));
		window.setTimeout(() => {
			for (const item of movingItems) {
				item.style.removeProperty("transition");
				item.style.removeProperty("transform");
			}
		}, 430);
		if (nextMode === "summary") typeSummary(summary, run);
		scheduleArticleSidebarSticky(true);
	}

	if (!sidebarWindow.__aiSummarySidebarInitialized) {
		sidebarWindow.__aiSummarySidebarInitialized = true;
		const registerSwup = () => window.swup?.hooks?.on("page:view", () => syncAISummary(false));
		if (window.swup) registerSwup();
		else document.addEventListener("swup:enable", registerSwup, { once: true });
	}
	requestAnimationFrame(() => syncAISummary(true));
</script>
