---
import { Icon } from "astro-icon/components";
import { announcementConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import WidgetLayout from "./WidgetLayout.astro";

const config = announcementConfig;
// Explicit version is supported, while the content fingerprint makes ordinary
// config edits automatically count as a new announcement.
const announcementVersion = config.version ?? JSON.stringify({
	title: config.title,
	content: config.content,
	link: config.link,
});

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout 
    name={config.title || i18n(I18nKey.announcement)} 
    id="announcement"
    class={className} 
    style={style}
>
    <div data-announcement-version={announcementVersion}>
        <!-- 公告栏内容 -->
        <div class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">
            {config.content}
        </div>
        
        <!-- 可选链接和关闭按钮 -->
        <div class="flex items-center justify-between gap-3">
            <div>
                {config.link && config.link.enable !== false && (
                    <a 
                        href={config.link.url} 
                        target={config.link.external ? "_blank" : "_self"}
                        rel={config.link.external ? "noopener noreferrer" : undefined}
                        class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
                    >
                        {config.link.text}

                    </a>
                )}
            </div>
            
            {config.closable && (
                <button 
                    class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
                    onclick="closeAnnouncement()"
                    aria-label={i18n(I18nKey.announcementClose)}
                >
                    <Icon name="fa6-solid:xmark" class="text-sm" />
                </button>
            )}
        </div>
    </div>
</WidgetLayout>

<script>
    const CLOSED_VERSION_KEY = 'announcementClosedVersion';

    function getAnnouncementElements() {
        const widgetLayout = document.querySelector<HTMLElement>('widget-layout[data-id="announcement"]');
        const item = widgetLayout?.closest<HTMLElement>('[data-sidebar-motion-item], .widget-container');
        const version = widgetLayout
            ?.querySelector<HTMLElement>('[data-announcement-version]')
            ?.dataset.announcementVersion;
        return { widgetLayout, item, version };
    }

    function closeAnnouncement() {
        const { item, version } = getAnnouncementElements();
        if (item && version) {
            // Hide the complete flex item so it no longer contributes a gap.
            item.hidden = true;
            localStorage.setItem(CLOSED_VERSION_KEY, version);
            localStorage.removeItem('announcementClosed');
        }
    }

    function syncAnnouncementVisibility() {
        const { item, version } = getAnnouncementElements();
        if (!item || !version) return;
        item.hidden = localStorage.getItem(CLOSED_VERSION_KEY) === version;
        // The legacy boolean cannot identify which announcement was closed.
        // Discard it so the current version is shown once and can be recorded.
        localStorage.removeItem('announcementClosed');
    }

    // The script can run both on first load and after a Swup replacement.
    syncAnnouncementVisibility();
    document.addEventListener('DOMContentLoaded', syncAnnouncementVisibility, { once: true });

    // 使公告栏函数全局可用
    window.closeAnnouncement = closeAnnouncement;
</script>
