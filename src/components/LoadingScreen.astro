---
import { siteConfig } from "@/config";
import { initialLoadingPreloadImages, CDN_PRELOAD_MAP } from "@/loading-preload";

const ROWS = 18;
const COLS = 18;
const HEX_W = 86.5;
const HEX_H = 74.5;
const rows = Array.from({ length: ROWS }, (_, rowIndex) => {
	const line = rowIndex + 1;
	return Array.from({ length: COLS }, (_, columnIndex) => {
		const column = columnIndex + 1;
		const x =
			line % 2 ? HEX_W * (column - 1) : HEX_W * (column - 1) + HEX_W / 2;
		const y = HEX_H * (line - 1);
		return { key: `${line}-${column}`, transform: `translate(${x}, ${y})` };
	});
});
const explicitPreloadImageUrls = initialLoadingPreloadImages;
const cdnMapping = CDN_PRELOAD_MAP();
const preloadHanaleiFont = Boolean(siteConfig.font?.hanalei?.enable);
const preloadBannerCarousel = Boolean(siteConfig.banner.carousel?.enable);
---
<!-- Keep the complete loader styling in the first body chunk. Astro would
	 otherwise extract it into a render-blocking page stylesheet. -->
<style is:inline>
	.initial-loading-screen {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: var(--page-bg);
	}

	.initial-loading-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(ellipse at center, var(--loader-glow) 0%, transparent 55%);
	}

	.initial-loading-grid {
		width: 100%;
		height: 100%;
	}

	.ld-hex {
		fill: var(--loader-hex-fill);
		stroke: var(--loader-hex-stroke);
		stroke-dasharray: 100;
		stroke-dashoffset: 100;
		stroke-opacity: 0;
	}
</style>

<div
	id="initial-loading-screen"
	class="initial-loading-screen"
	role="status"
	aria-live="polite"
	aria-label="页面正在加载"
>
	<div class="initial-loading-glow" aria-hidden="true"></div>
	<svg
		id="initial-loading-grid"
		class="initial-loading-grid"
		viewBox="0 0 1400 1200"
		preserveAspectRatio="xMidYMid slice"
		aria-hidden="true"
	>
		{rows.map((hexes) => (
			<g>
				{hexes.map((hex) => (
					<polygon
						class="ld-hex"
						points="0,-50 43.3,-25 43.3,25 0,50 -43.3,25 -43.3,-25"
						stroke-width="0.8"
						transform={hex.transform}
					/>
				))}
			</g>
		))}
	</svg>
	<span class="sr-only">页面正在加载</span>
</div>

<noscript>
	<style>
		#initial-loading-screen { display: none !important; }
	</style>
</noscript>

<script is:inline define:vars={{ explicitPreloadImageUrls, cdnMapping, preloadHanaleiFont, preloadBannerCarousel }}>
	(() => {
		if (window.__tonksInitialLoaderStarted) return;
		window.__tonksInitialLoaderStarted = true;

		const ROWS = 16;
		const COLS = 18;
		const TOTAL = ROWS * COLS;
		const root = document.getElementById("initial-loading-screen");
		const svg = document.getElementById("initial-loading-grid");
		if (!root || !svg) return;

		const isDark = document.documentElement.classList.contains("dark");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const hexStroke = isDark ? "rgba(255,255,255,0.5)" : "hsl(207 70% 65%)";
		const hexBaseFill = isDark ? "rgba(255,255,255,0.03)" : "rgba(200,225,245,0.25)";
		const glowColor = isDark ? "rgba(255,255,255,0.08)" : "hsl(207 70% 65% / 0.2)";
		root.style.setProperty("--loader-hex-stroke", hexStroke);
		root.style.setProperty("--loader-hex-fill", hexBaseFill);
		root.style.setProperty("--loader-glow", glowColor);

		const hexes = Array.from(svg.querySelectorAll(".ld-hex"));

		function activateBannerImage(img, priority) {
			return new Promise((resolve) => {
				const src = img.dataset.bannerSrc;
				if (!src) {
					resolve();
					return;
				}
				const localFallback = img.dataset.bannerLocal || null;
				const preload = new Image();
				preload.decoding = "async";
				preload.fetchPriority = priority;
				preload.onload = () => {
					img.fetchPriority = priority;
					img.src = src;
					delete img.dataset.bannerSrc;
					delete img.dataset.bannerLocal;
					resolve();
				};
				preload.onerror = () => {
					if (localFallback) {
						window.__tonksCdnFailed = true;
						const retry = new Image();
						retry.decoding = "async";
						retry.fetchPriority = priority;
						retry.onload = retry.onerror = () => {
							img.fetchPriority = priority;
							img.src = localFallback;
							delete img.dataset.bannerSrc;
							delete img.dataset.bannerLocal;
							resolve();
						};
						retry.src = localFallback;
					} else {
						img.fetchPriority = priority;
						img.src = src;
						delete img.dataset.bannerSrc;
						delete img.dataset.bannerLocal;
						resolve();
					}
				};
				preload.src = src;
			});
		}

		function preloadInitialBannerImages() {
			const isMobile = window.matchMedia("(max-width: 1023px)").matches;
			const isHome = document.body.classList.contains("lg:is-home");
			if (isMobile && !isHome) return Promise.resolve();
			const device = isMobile ? "mobile" : "desktop";
			const limit = isHome && preloadBannerCarousel
				? (isMobile ? 2 : 3) : 1;
			return new Promise((resolve) => {
				let observer;
				const collect = () => {
					const images = Array.from(
						document.querySelectorAll(`[data-banner-device="${device}"] img[data-banner-src]`),
					).slice(0, limit);
					if (!images.length) return false;
					observer?.disconnect();
					Promise.all(
						images.map((img, index) =>
							activateBannerImage(img, index === 0 ? "high" : "low"),
						),
					).then(resolve);
					return true;
				};

				if (collect()) return;
				observer = new MutationObserver(collect);
				observer.observe(document.body, { childList: true, subtree: true });
				whenDomReady().then(() => {
					if (!collect()) {
						observer.disconnect();
						resolve();
					}
				});
			});
		}

		function preloadExplicitImages() {
			return Promise.all(
				explicitPreloadImageUrls.map((localSrc) => {
					const cdnSrc = cdnMapping[localSrc] || null;
					const primary = cdnSrc || localSrc;
					return new Promise((resolve) => {
						const image = new Image();
						image.decoding = "async";
						image.onload = resolve;
						image.onerror = () => {
							if (cdnSrc && !window.__tonksCdnFailed) {
								// CDN 失败 → 标记不可达并重试本地
								window.__tonksCdnFailed = true;
								const fallbackImg = new Image();
								fallbackImg.decoding = "async";
								fallbackImg.onload = fallbackImg.onerror = resolve;
								fallbackImg.src = localSrc;
							} else {
								resolve();
							}
						};
						image.src = primary;
					});
				}),
			);
		}

		function preloadCriticalFonts() {
			if (!preloadHanaleiFont || !document.fonts?.load) return Promise.resolve();
			return document.fonts
				.load('1em "Hanalei"')
				.then((faces) => {
					if (faces.length > 0) {
						document.documentElement.classList.add("hanalei-font-loaded");
					}
				})
				.catch(() => {});
		}

		function whenDomReady() {
			if (document.readyState !== "loading") return Promise.resolve();
			return new Promise((resolve) => {
				document.addEventListener("DOMContentLoaded", resolve, { once: true });
			});
		}

		function withMaximumWait(promise, timeoutMs) {
			return Promise.race([
				promise,
				new Promise((resolve) => setTimeout(resolve, timeoutMs)),
			]);
		}

		function waitForVisibleCriticalImages() {
			const images = Array.from(document.querySelectorAll("img[src]"))
				.filter((img) => !img.closest("[data-banner-device]"))
				.filter((img) => img.loading !== "lazy")
				.filter((img) => {
					const rect = img.getBoundingClientRect();
					return rect.top < window.innerHeight * 1.2 && rect.bottom > 0;
				});
			return Promise.all(
				images.map((img) => {
					if (typeof img.decode === "function") return img.decode().catch(() => {});
					if (img.complete) return Promise.resolve();
					return new Promise((resolve) => {
						img.addEventListener("load", resolve, { once: true });
						img.addEventListener("error", resolve, { once: true });
					});
				}),
			);
		}

		async function playReveal() {
			if (!hexes.length || reducedMotion) return;
			const revealAnims = hexes.map((el, i) => {
				const from = Math.random() > 0.5 ? -100 : 100;
				return el.animate(
					[
						{ strokeDashoffset: from, strokeOpacity: 0, offset: 0 },
						{ strokeDashoffset: 0, strokeOpacity: 1, offset: 1 },
					],
					{
						duration: 400,
						delay: Math.random() * 200 + i * 1.5,
						easing: "cubic-bezier(0.25, 0, 0.25, 1)",
						fill: "forwards",
					},
				);
			});
			await Promise.all(revealAnims.map((animation) => animation.finished));
		}

		async function playCollapse() {
			if (!hexes.length || reducedMotion) return;
			const centerIdx = Math.floor(TOTAL / 2);
			const sorted = hexes
				.map((el, i) => ({
					el,
					dist: Math.abs(i - centerIdx) + Math.abs((i % COLS) - Math.floor(COLS / 2)),
				}))
				.sort((a, b) => a.dist - b.dist);
			const collapseAnims = sorted.map(({ el }, i) =>
				el.animate(
					[
						{ opacity: 1, offset: 0 },
						{ opacity: 0, offset: 1 },
					],
					{
						duration: 350,
						delay: i * 2,
						easing: "cubic-bezier(0.5, 0, 0.75, 0)",
						fill: "forwards",
					},
				),
			);
			await Promise.all(collapseAnims.map((animation) => animation.finished));
		}

		async function fadeContainer() {
			await root.animate(
				[{ opacity: 1 }, { opacity: 0 }],
				{
					duration: reducedMotion ? 150 : 350,
					easing: "ease-out",
					fill: "forwards",
				},
			).finished;
		}

		async function run() {
			const preloadPromise = withMaximumWait(Promise.all([
				preloadCriticalFonts(),
				preloadExplicitImages(),
				whenDomReady().then(() => waitForVisibleCriticalImages()),
				preloadInitialBannerImages(),
			]), 20000);

			await new Promise((resolve) => requestAnimationFrame(resolve));
			await new Promise((resolve) => requestAnimationFrame(resolve));

			const ring = [115, 116, 117, 135, 154, 171, 189, 188, 187, 168, 150, 132];
			const ringLength = ring.length;
			const colors = isDark
				? [
					"rgba(255,255,255,0.22)",
					"rgba(255,255,255,0.45)",
					"rgba(255,255,255,0.72)",
					"rgba(255,255,255,1)",
				]
				: [
					"rgba(175,210,238,0.45)",
					"rgba(160,210,240,0.55)",
					"rgba(110,185,230,0.78)",
					"hsl(207,70%,65%)",
				];
			const intensities = new Array(ringLength).fill(0);
			let cursor = 0;

			ring.forEach((index) => {
				const el = hexes[index];
				if (el) el.style.transition = "fill 500ms ease-out";
			});
			setTimeout(() => {
				ring.forEach((index) => {
					const el = hexes[index];
					if (el) el.style.fill = colors[0];
				});
			}, 500);

			await playReveal();

			function applyColor(index, level) {
				const el = hexes[ring[index]];
				if (el) el.style.fill = colors[level];
			}

			function spinnerTick() {
				intensities[cursor] = 3;
				applyColor(cursor, 3);
				for (let index = 0; index < ringLength; index++) {
					if (index === cursor) continue;
					const previous = intensities[index];
					if (previous > 0) {
						intensities[index] = previous - 1;
						applyColor(index, previous - 1);
					}
				}
				cursor = (cursor + 1) % ringLength;
			}

			let spinnerTimer;
			if (!reducedMotion) {
				spinnerTimer = setInterval(spinnerTick, 100);
				spinnerTick();
			}

			await preloadPromise;
			if (spinnerTimer) clearInterval(spinnerTimer);

			const doneColor = isDark ? "hsl(45, 100%, 62%)" : "hsl(145, 50%, 55%)";
			ring.forEach((index) => {
				if (hexes[index]) hexes[index].style.fill = doneColor;
			});

			await playCollapse();
			await fadeContainer();
			root.dataset.complete = "true";
			window.dispatchEvent(new CustomEvent("tonks:initial-loader:done"));
			root.remove();
		}

		const start = () => run().catch(() => {
			root.dataset.complete = "true";
			window.dispatchEvent(new CustomEvent("tonks:initial-loader:done"));
			root.remove();
		});

		start();
	})();
</script>
