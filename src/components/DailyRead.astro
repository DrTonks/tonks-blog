---
import { Icon } from "astro-icon/components";
import type { FriendLink } from "../data/friends";
interface Props { friends: FriendLink[]; }
const { friends } = Astro.props;
---
<section class="daily-read" data-daily-read data-friends={JSON.stringify(friends.filter(friend => friend.rss))} aria-labelledby="daily-read-heading">
	<div class="daily-read__decoration" aria-hidden="true"><img class="daily-read__portrait" data-daily-avatar alt="" width="200" height="200" decoding="async" hidden /></div>
	<span class="daily-read__binding" aria-hidden="true"></span>
	<header class="daily-read__header">
		<div class="daily-read__label"><span class="daily-read__eyebrow">FRIENDS’ NOTEBOOK</span><h2 id="daily-read-heading">每日一读</h2></div>
		<button type="button" class="daily-read__refresh" data-daily-refresh disabled><Icon name="material-symbols:refresh-rounded" /><span>换一篇</span></button>
	</header>
	<div class="daily-read__content" data-daily-content>
		<a class="daily-read__article" data-daily-link target="_blank" rel="noopener noreferrer" aria-disabled="true"><h3 data-daily-title>翻开朋友们的新一页</h3></a>
		<p class="daily-read__summary" data-daily-summary>正在收集最近的文字，稍等片刻。</p>
		<footer class="daily-read__footer"><div class="daily-read__source" data-daily-source hidden><a data-daily-site target="_blank" rel="noopener noreferrer"></a><span aria-hidden="true">·</span><time data-daily-date></time><span data-daily-stale hidden>缓存记录</span></div><a data-daily-read-link class="daily-read__go" target="_blank" rel="noopener noreferrer" hidden>读这篇<Icon name="material-symbols:arrow-outward-rounded" /></a></footer>
	</div>
	<p class="sr-only" data-daily-status role="status"></p>
	<noscript><p class="daily-read__noscript">启用 JavaScript 后可抽取好友的新文章，也可以从下方友链直接访问。</p></noscript>
</section>
<script>import "../scripts/friend-reading";</script>
<style>
.daily-read{--paper-line:color-mix(in srgb,currentColor 8%,transparent);--notebook-ink:var(--text-secondary);--notebook-paper:color-mix(in srgb,var(--text-secondary) 4%,var(--card-bg));position:relative;isolation:isolate;margin:1.8rem .55rem 1.4rem;padding:1.4rem 1.75rem 1.2rem 3.4rem;color:var(--text-secondary);border:1px solid color-mix(in srgb,var(--primary) 45%,var(--card-bg));border-radius:3px 10px 10px 3px;background:radial-gradient(ellipse at 0% 100%,color-mix(in srgb,var(--text-secondary) 5%,transparent),transparent 58%),linear-gradient(115deg,var(--notebook-paper),var(--card-bg) 78%);box-shadow:0 3px 0 -1px var(--notebook-paper),0 4px 0 -1px color-mix(in srgb,currentColor 17%,transparent),0 8px 20px rgb(0 0 0 / .035)}
.daily-read::before{content:"";position:absolute;z-index:-1;inset:0;background:repeating-linear-gradient(transparent 0,transparent calc(1.8rem - 1px),var(--paper-line) calc(1.8rem - 1px),var(--paper-line) 1.8rem);opacity:.45;pointer-events:none;border-radius:inherit}
.daily-read__decoration{position:absolute;z-index:-1;inset:0;overflow:hidden;border-radius:inherit;pointer-events:none;user-select:none}
.daily-read__portrait{position:absolute;left:-2rem;bottom:-3.6rem;width:12.5rem;height:12.5rem;max-width:none;object-fit:cover;border-radius:1.1rem;transform:rotate(-14deg);opacity:.075;filter:saturate(.4);mask-image:linear-gradient(35deg,#000 35%,rgb(0 0 0 / .65) 75%,transparent)}
:global(.dark) .daily-read__portrait{opacity:.1}
.daily-read__binding{position:absolute;left:1.8rem;top:0;bottom:0;width:1px;background:color-mix(in srgb,var(--notebook-ink) 22%,transparent);pointer-events:none}
.daily-read__binding::after{content:"";position:absolute;left:-1.15rem;top:1.9rem;width:6px;height:6px;border:1px solid color-mix(in srgb,currentColor 25%,transparent);border-radius:50%;background:var(--card-bg);box-shadow:0 4.4rem 0 -1px var(--card-bg),0 4.4rem 0 0 color-mix(in srgb,currentColor 25%,transparent),0 8.8rem 0 -1px var(--card-bg),0 8.8rem 0 0 color-mix(in srgb,currentColor 25%,transparent)}
.daily-read__header{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.daily-read__eyebrow{display:block;font:500 .6rem/1.5 "JetBrains Mono Variable",monospace;letter-spacing:.16em;color:var(--text-muted)}
.daily-read h2{display:flex;align-items:center;gap:.8rem;margin:.3rem 0 0;font-size:1rem;font-weight:650;letter-spacing:.18em;color:color-mix(in srgb,var(--primary) 42%,var(--text-secondary))}
.daily-read h2::after{content:"";width:1.8rem;height:1px;background:color-mix(in srgb,var(--notebook-ink) 45%,transparent)}
.daily-read__refresh{display:flex;align-items:center;justify-content:center;gap:.35rem;min-height:44px;padding:0 .7rem;font-size:.75rem;color:var(--text-secondary);border:1px solid transparent;border-radius:5px;transition:background 180ms,border-color 180ms;cursor:pointer}
.daily-read__refresh :global(svg){width:1rem;height:1rem}.daily-read__refresh:hover:not(:disabled){color:var(--notebook-ink);background:color-mix(in srgb,var(--text-secondary) 7%,transparent);border-color:color-mix(in srgb,var(--notebook-ink) 18%,transparent)}.daily-read__refresh:disabled{opacity:.4;cursor:default}
.daily-read__article{display:block;color:var(--text-primary,inherit)}.daily-read h3{margin:0;font-size:clamp(1.1rem,2vw,1.45rem);font-weight:650;line-height:1.55;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;min-height:3.1em}.daily-read__article[href]:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em}
.daily-read__summary{font-size:.875rem;line-height:1.8;margin:.5rem 0 .75rem;min-height:3.6em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--text-secondary)}
.daily-read__article{transition:color 180ms}.daily-read__article[href]:hover{color:var(--notebook-ink)}.daily-read__source a,.daily-read__go{color:var(--notebook-ink);font-weight:550}
.daily-read__footer{display:flex;justify-content:space-between;align-items:center;gap:.5rem;min-height:2rem;font-size:.75rem;color:var(--text-muted)}.daily-read__source{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem}.daily-read__source a:hover{text-decoration:underline}.daily-read__go{display:flex;align-items:center;gap:.3rem;min-height:44px;flex-shrink:0;color:var(--notebook-ink)}.daily-read__go :global(svg){width:.9rem;height:.9rem}.daily-read :focus-visible{outline:2px solid var(--primary);outline-offset:3px}.daily-read [hidden]{display:none}.daily-read__noscript{font-size:.8rem}.daily-read [data-daily-stale]{font-size:.65rem;border-bottom:1px dotted currentColor}
@media(max-width:720px){.daily-read{margin:1.5rem 0;padding:1.1rem 1rem .85rem 2.5rem}.daily-read__binding{left:1.4rem}.daily-read__binding::after{left:-.9rem}.daily-read__header{gap:.4rem}.daily-read__eyebrow{font-size:.5rem}.daily-read__refresh{padding-inline:.45rem}.daily-read__footer{align-items:flex-start}.daily-read__source{gap:.3rem;max-width:75%}.daily-read__go{min-height:44px}.daily-read__source time{white-space:nowrap}}
@media(max-width:720px){.daily-read__portrait{width:10.5rem;height:10.5rem;left:-2rem;bottom:-2.8rem}}
@media(prefers-reduced-motion:reduce){.daily-read__refresh,.daily-read__article{transition:none}}
</style>
