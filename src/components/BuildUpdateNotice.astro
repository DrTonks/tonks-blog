<aside id="build-update-notice" aria-labelledby="build-update-title" hidden>
  <div class="update-emblem" aria-hidden="true">↻</div>
  <div class="update-copy">
    <span class="update-kicker">A FRESH EDITION</span>
    <h2 id="build-update-title">检测到版本更新</h2>
    <p role="status" aria-live="polite" data-update-description>上传了新的内容或者调整了页面的样式，更新拉取后获取最新内容</p>
    <div class="update-actions">
      <button type="button" data-update-now>立即更新 <span aria-hidden="true">↗</span></button>
      <button type="button" data-update-later>稍后再说</button>
    </div>
  </div>
</aside>
<script>
  import { initializeBuildUpdates } from '../scripts/build-updates';
  if (import.meta.env.PROD) initializeBuildUpdates(import.meta.env.PUBLIC_BUILD_ID);
</script>
