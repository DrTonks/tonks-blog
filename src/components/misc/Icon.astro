---
import { buildIcon, replaceIDs } from '@iconify/svelte/dist/functions.js';
import { findLocalIcon } from '../../utils/local-icons.server.mjs';

export interface Props {
	icon: string;
	class?: string;
	style?: string;
	size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
	color?: string;
	fallback?: string; // 备用图标或文本
	loading?: "lazy" | "eager";
}

const {
	icon,
	class: className = "",
	style = "",
	size,
	color,
	fallback = "●",
} = Astro.props;

// 尺寸映射
const sizeClasses = {
	xs: "text-xs",
	sm: "text-sm",
	md: "text-base",
	lg: "text-lg",
	xl: "text-xl",
	"2xl": "text-2xl",
};

const hasSizeClass = className.split(/\s+/).some(name => Object.values(sizeClasses).includes(name));
const sizeClass = size ? sizeClasses[size] : hasSizeClass ? "" : sizeClasses.md;
const colorStyle = color ? `color: ${color};` : "";
const combinedStyle = `${colorStyle}${style}`;
const combinedClass = `${sizeClass} ${className}`.trim();

const data = findLocalIcon(icon);
const svg = data && buildIcon(data);
---
<span class={`inline-flex min-w-[1em] min-h-[1em] items-center justify-center ${combinedClass}`} style={combinedStyle}>
  {svg ? <svg {...svg.attributes} aria-hidden="true" set:html={replaceIDs(svg.body)} /> : fallback}
</span>
