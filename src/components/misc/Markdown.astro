---
// 只加载基础的等宽字体，减少加载时间
import "@fontsource-variable/jetbrains-mono";
import { getCollection } from "astro:content";
import { optimizedImage } from "../../utils/optimized-image";
import { getImage } from "astro:assets";
import { parse } from "node-html-parser";
import { getPostUrlBySlug } from "../../utils/url-utils";
import "../../styles/article.css";
import { annotateCommentBlocks, saveDevCommentManifest } from "../../utils/article-comment-map.mjs";

interface Props {
	class: string;
	commentSlug?: string;
}
const className = Astro.props.class;
const rendered = parse(await Astro.slots.render("default"));
const references = rendered.querySelectorAll("post-reference");
const escape = (value: string) => value.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
if (references.length) {
  const posts = await getCollection("posts");
  const images = import.meta.glob<{ default: ImageMetadata }>("/src/content/posts/**/*.{png,jpg,jpeg,JPG,webp,avif,gif}");
  for (const ref of references) {
    const slug = ref.getAttribute("slug");
    const post = posts.find((entry) => entry.slug === slug);
    if (!post) throw new Error(`Unknown post reference: ${slug}`);
    if (import.meta.env.PROD && post.data.draft) throw new Error(`Cannot reference draft post: ${slug}`);
    let cover = optimizedImage(post.data.image || "");
    if (cover && !/^(https?:\/\/|\/)/.test(cover)) {
      const directory = post.id.slice(0, post.id.lastIndexOf("/") + 1);
      const imagePath = `/src/content/posts/${directory}${cover.replace(/^\.\//, "")}`;
      const loader = images[imagePath];
      if (!loader) throw new Error(`Post reference cover not found: ${imagePath}`);
      cover = (await getImage({ src: (await loader()).default, width: 320, format: "webp" })).src;
    }
    ref.replaceWith(`<a class="article-post-card no-styling" href="${escape(getPostUrlBySlug(post.slug))}">${cover ? `<img src="${escape(cover)}" alt="" width="160" height="110" loading="lazy" decoding="async">` : '<span class="post-card-placeholder" aria-hidden="true">↗</span>'}<span class="post-card-copy"><span class="post-card-label">站内延伸阅读</span><strong>${escape(post.data.title)}</strong><span class="post-card-description">${escape(post.data.description || "阅读这篇文章")}</span></span><span aria-hidden="true" class="post-card-arrow">↗</span></a>`);
  }
}
const commentMap = Astro.props.commentSlug ? annotateCommentBlocks(rendered, Astro.props.commentSlug) : null;
if (commentMap && import.meta.env.DEV) saveDevCommentManifest(commentMap);
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md ${className}`}>
    <!--<div class="prose dark:prose-invert max-w-none custom-md">-->
    <!--<div class="max-w-none custom-md">-->
    <Fragment set:html={rendered.toString()} />
    {commentMap && <script is:inline type="application/json" data-article-comment-map set:html={JSON.stringify(commentMap).replace(/</g, '\\u003c')} />}
</div>
