---
---
<!-- Overlay only: the document remains the scroll container. -->
<div id="page-scrollbar" role="scrollbar" aria-label="页面滚动位置" aria-controls="main-panel-wrapper" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0" hidden>
  <div class="page-scrollbar-thumb"></div>
</div>
<style>
 :global(html) { scrollbar-width: none; scrollbar-gutter: auto; }
 :global(html::-webkit-scrollbar), :global(body::-webkit-scrollbar) { width: 0; height: 0; }
 #page-scrollbar { position: fixed; inset: 4px 0 4px auto; width: 12px; z-index: 60; touch-action: none; user-select: none; cursor: pointer; }
 #page-scrollbar[hidden] { display: none; }
 .page-scrollbar-thumb { position: absolute; top: 0; right: 3px; width: 4px; height: 1px; transform-origin: top; background: var(--primary); opacity: .42; border-radius: 2px; transition: transform 160ms ease-out, width 150ms ease, opacity 150ms ease; }
 #page-scrollbar.dragging .page-scrollbar-thumb { transition: width 150ms ease, opacity 150ms ease; }
 #page-scrollbar:hover .page-scrollbar-thumb, #page-scrollbar:focus-visible .page-scrollbar-thumb, #page-scrollbar.dragging .page-scrollbar-thumb { width: 8px; opacity: .95; }
 #page-scrollbar:focus-visible { outline: 1px solid var(--primary); outline-offset: -1px; }
 @media (prefers-reduced-motion: reduce) { #page-scrollbar .page-scrollbar-thumb, #page-scrollbar.dragging .page-scrollbar-thumb { transition: none; } }
</style>
<script>
const rail = document.querySelector<HTMLElement>("#page-scrollbar")!;
const thumb = rail.querySelector<HTMLElement>(".page-scrollbar-thumb")!;
let frame = 0;
let dragging: number | null = null;
let grabOffset = 0;
function metrics() {
 const height = innerHeight - 8;
 const page = document.documentElement.scrollHeight;
 const size = Math.min(height, Math.max(32, height * innerHeight / Math.max(page, 1)));
 return { height, size, travel: Math.max(0, height - size), max: Math.max(0, page - innerHeight) };
}
function paint() {
 frame = 0;
 const m = metrics();
 const progress = m.max ? Math.min(1, Math.max(0, scrollY / m.max)) : 0;
 rail.hidden = m.max <= 1;
 thumb.style.transform = `translateY(${m.travel * progress}px) scaleY(${m.size})`;
 rail.setAttribute("aria-valuenow", String(Math.round(progress * 100)));
}
function schedule() { if (!frame) frame = requestAnimationFrame(paint); }
function dragTo(y: number) {
 const m = metrics();
 const ratio = m.travel ? (y - 4 - grabOffset) / m.travel : 0;
 window.scrollTo({ top: Math.max(0, Math.min(1, ratio)) * m.max, behavior: "instant" });
}
rail.addEventListener("pointerdown", event => {
 if (event.button !== 0 || dragging !== null) return;
 event.preventDefault();
 const m = metrics();
 grabOffset = event.target === thumb ? event.clientY - thumb.getBoundingClientRect().top : m.size / 2;
 dragging = event.pointerId;
 rail.setPointerCapture(event.pointerId);
 rail.classList.add("dragging");
 rail.focus({ preventScroll: true });
 dragTo(event.clientY);
});
rail.addEventListener("pointermove", event => { if (dragging === event.pointerId) dragTo(event.clientY); });
function endDrag() { dragging = null; rail.classList.remove("dragging"); }
rail.addEventListener("lostpointercapture", endDrag);
rail.addEventListener("pointerup", event => { if (rail.hasPointerCapture(event.pointerId)) rail.releasePointerCapture(event.pointerId); endDrag(); });
rail.addEventListener("pointercancel", endDrag);
rail.addEventListener("keydown", event => {
 const destinations: Record<string, number> = { ArrowDown: scrollY + 48, ArrowUp: scrollY - 48, PageDown: scrollY + innerHeight * .9, PageUp: scrollY - innerHeight * .9, Home: 0, End: metrics().max };
 if (!(event.key in destinations)) return;
 event.preventDefault();
 window.scrollTo({ top: destinations[event.key], behavior: "instant" });
});
window.addEventListener("scroll", schedule, { passive: true });
window.addEventListener("resize", schedule, { passive: true });
document.addEventListener("swup:page:view", schedule);
new ResizeObserver(schedule).observe(document.body);
schedule();
</script>
