---
import {Icon} from "astro-icon/components";
import { url } from "../../utils/url-utils";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper block">
    <div id="back-to-home-btn" class="back-to-top-btn back-to-home-btn hide flex items-center rounded-2xl overflow-hidden" inert>
        <a href={url("/")} aria-label="返回首页" title="返回首页" class="btn-card flex items-center justify-center h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:home-outline-rounded" class="mx-auto" />
        </a>
    </div>
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition"
         onclick="backToTop()">
        <svg class="reading-progress" viewBox="0 0 60 60" aria-hidden="true">
            <path d="M16 2 H44 A14 14 0 0 1 58 16 V44 A14 14 0 0 1 44 58 H16 A14 14 0 0 1 2 44 V16 A14 14 0 0 1 16 2 Z" pathLength="100" />
        </svg>
        <button type="button" aria-label="回到页头" title="回到页头" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
    <div id="back-to-bottom-btn" class="back-to-top-btn back-to-bottom-btn flex items-center rounded-2xl overflow-hidden transition">
        <button type="button" aria-label="跳到页尾" title="跳到页尾" class="btn-card h-[3.75rem] w-[3.75rem]" data-bottom-control>
            <span class="bottom-icon bottom-icon--arrow"><Icon name="material-symbols:keyboard-arrow-down-rounded" /></span><span class="bottom-icon bottom-icon--comment"><Icon name="material-symbols:chat-bubble-outline-rounded" /></span>
        </button>
    </div>
</div>

<style lang="stylus">
  .reading-progress
    position absolute
    inset 0
    width 100%
    height 100%
    z-index 1
    pointer-events none
    fill none
    stroke var(--primary)
    stroke-width 3
    stroke-dasharray 100
    stroke-dashoffset var(--reading-offset, 100)

  .back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

  .back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    // Keep the control above article cards and their mobile compositing layers.
    z-index: 40
    bottom: 10rem
    opacity: 1
    right: 6rem
    cursor: pointer
    transform: translateX(5rem)
    pointer-events: auto
    visibility: visible
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s, box-shadow 1s ease-in-out

    i
      font-size: 1.75rem

    &.hide
      visibility: hidden
      transform: translateX(5rem) scale(0.9)
      opacity: 0
      pointer-events: none
      transition: opacity 180ms ease, transform 180ms ease, visibility 0s 180ms, box-shadow 1s ease-in-out

    &:active
      transform: translateX(5rem) scale(0.9)

  .back-to-bottom-btn
    bottom: 5.5rem

  .back-to-home-btn
    bottom: 14.5rem

  @media (prefers-reduced-motion: reduce)
    .back-to-top-btn, .back-to-top-btn.hide
      transition: none

  @media (max-width: 1560px)
    .back-to-top-btn
      box-shadow:
              0 0 0 1px var(--btn-regular-bg) ,
              0 0 1em var(--btn-regular-bg) ;

  // 手机端隐藏返回顶部按钮
  @media (max-width: 768px)
    .back-to-top-wrapper
      display: none

</style>

<script is:raw is:inline>
    function backToTop() {
        // 直接使用原生滚动，避免OverlayScrollbars冲突
        window.scroll({top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
    }
</script>

<script>
// One passive scroll listener, at most one geometry read/update per animation frame.
let frame = 0;
function updateReadingProgress() {
    frame = 0;
    const control = document.querySelector<HTMLElement>("#back-to-top-btn");
    if (!control) return;
    const article = document.querySelector<HTMLElement>("#post-container .custom-md");
    const maxScroll = Math.max(0, document.documentElement.scrollHeight - innerHeight);
    const rect = article?.getBoundingClientRect();
    const start = rect ? Math.min(maxScroll, Math.max(0, rect.top + scrollY - 80)) : 0;
    const end = rect ? Math.min(maxScroll, Math.max(start, rect.bottom + scrollY - innerHeight)) : maxScroll;
    const progress = end > start ? Math.max(0, Math.min(1, (scrollY - start) / (end - start))) : (scrollY >= start ? 1 : 0);
    const percent = Math.round(progress * 100);
    control.style.setProperty("--reading-offset", String(100 - progress * 100));
    const label = `回到页头 · ${article ? "阅读" : "页面"}进度 ${percent}%`;
    control.querySelector("button")?.setAttribute("title", label);
    control.querySelector("button")?.setAttribute("aria-label", label);
}
function syncBottomControl(){
    const button=document.querySelector<HTMLButtonElement>('[data-bottom-control]');if(!button)return;
    const board=document.querySelector<HTMLElement>('[data-article-comments], [data-community-comments]');
    button.toggleAttribute('data-comments',!!board);
    const label=board?'跳到留言区':'跳到页尾';button.title=label;button.setAttribute('aria-label',label);
    button.onclick=()=>{const behavior=matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth';
      if(board)board.scrollIntoView({behavior,block:'start'});else window.scrollTo({top:document.documentElement.scrollHeight,behavior});
    };
}
function scheduleProgress() {
    if (!frame) frame = requestAnimationFrame(updateReadingProgress);
}
window.addEventListener("scroll", scheduleProgress, { passive: true });
window.addEventListener("resize", scheduleProgress, { passive: true });
document.addEventListener("swup:page:view", scheduleProgress);
document.addEventListener("astro:page-load", scheduleProgress);
new ResizeObserver(()=>{scheduleProgress();syncBottomControl();}).observe(document.body);
const syncHook=()=>window.swup?.hooks.on('page:view',syncBottomControl);
if(window.swup)syncHook();else document.addEventListener('swup:enable',syncHook,{once:true});
document.addEventListener('astro:page-load',syncBottomControl);
syncBottomControl();
scheduleProgress();
</script>

<style>
[data-bottom-control]{position:relative}
.bottom-icon{position:absolute;inset:0;display:grid;place-items:center;transition:opacity 180ms ease,transform 180ms ease}
.bottom-icon--comment{opacity:0;transform:translateY(8px) scale(.8)}
[data-bottom-control][data-comments] .bottom-icon--arrow{opacity:0;transform:translateY(-8px) scale(.8)}
[data-bottom-control][data-comments] .bottom-icon--comment{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.bottom-icon{transition:none}}
</style>
