---
import frames from '../assets/signature/frames.webp?url';
import still from '../assets/signature/still.webp?url';
import { profileConfig } from '../config';
---

<profile-signature data-frames={frames} data-still={still} style={`--signature-still: url("${still}")`}>
  <span class="sr-only">{profileConfig.name}</span>
  <span class="signature-reveal" aria-hidden="true"><span class="signature-ink"></span></span>
</profile-signature>

<style>
  profile-signature {
    --signature-max-width: 15rem;
    display: block;
    position: relative;
    z-index: 1;
    width: 78%;
    max-width: var(--signature-max-width);
    aspect-ratio: 221 / 98;
    /* 40% of the responsive height: width × (98 / 221) × 0.4. */
    margin: calc(min(78%, var(--signature-max-width)) * -0.1773755656) auto 0.5rem;
    pointer-events: none;
    /* A crisp, narrow edge separates the ink without a soft glow. */
    filter: drop-shadow(0 1px 0 var(--card-bg)) drop-shadow(0 -1px 0 var(--card-bg))
      drop-shadow(1px 0 0 var(--card-bg)) drop-shadow(-1px 0 0 var(--card-bg));
  }
  .signature-reveal, .signature-ink {
    display: block;
    width: 100%;
    height: 100%;
  }
  .signature-ink {
    background: var(--text-accent);
    mask-image: var(--signature-still);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
  [data-state="pending"] .signature-ink { visibility: hidden; }
  [data-state="playing"] .signature-reveal {
    mask-image: var(--signature-frames);
    mask-size: 3600% 100%;
    mask-repeat: no-repeat;
  }
  @media (max-width: 1023px) {
    profile-signature { --signature-max-width: 10rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-state="pending"] .signature-ink { visibility: visible; }
  }
</style>

<script>
  import { delays } from '../assets/signature/timing.json';
  import { createProfileSignature } from '../utils/profile-signature';

  if (!customElements.get('profile-signature')) {
    customElements.define('profile-signature', createProfileSignature(delays));
  }
</script>
