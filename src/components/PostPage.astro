---
import PostCardList from "./PostCardList.astro";
import { siteConfig } from "../config";
const { page, pool } = Astro.props;
---
<div class="post-list-shell" data-post-list-root data-total={page.total} data-static-page={page.currentPage}>
  <div id="post-list-container" class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] md:bg-transparent gap-2 md:gap-4 mb-4 list-mode" data-default-layout={siteConfig.postListLayout.defaultMode}>
    <PostCardList entries={page.data} offset={page.start} />
  </div>
  <template data-post-pool data-pagefind-ignore><PostCardList entries={pool.map(item => item.entry)} indices={pool.map(item => item.index)} /></template>
  <p class="sr-only" data-post-list-announcement aria-live="polite" aria-atomic="true"></p>
</div>
<noscript><style>[data-post-list-root] { visibility: visible !important; } #post-list-container { opacity: 1 !important; } [data-post-list-root] .onload-animation { animation-play-state: running !important; }</style></noscript>
