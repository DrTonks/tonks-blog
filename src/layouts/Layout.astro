function initCustomScrollbar() {
	// 完全禁用OverlayScrollbars的body初始化，避免导致页面重新加载
	// 只处理katex元素的滚动条
	const katexElements = document.querySelectorAll('.katex-display:not([data-scrollbar-initialized])') as NodeListOf<HTMLElement>;
	katexElements.forEach(element => {
		if (!element.parentNode) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		element.parentNode.insertBefore(container, element);
		container.appendChild(element);

		// 使用简单的CSS滚动条而不是OverlayScrollbars
		container.style.cssText = `
			overflow-x: auto;
			scrollbar-width: thin;
			scrollbar-color: rgba(0,0,0,0.3) transparent;
		`;
		
		// 为webkit浏览器添加自定义滚动条样式
		const style = document.createElement('style');
		style.textContent = `
			.katex-display-container::-webkit-scrollbar {
				height: 6px;
			}
			.katex-display-container::-webkit-scrollbar-track {
				background: transparent;
			}
			.katex-display-container::-webkit-scrollbar-thumb {
				background: rgba(0,0,0,0.3);
				border-radius: 3px;
			}
			.katex-display-container::-webkit-scrollbar-thumb:hover {
				background: rgba(0,0,0,0.5);
			}
		`;
		if (!document.head.querySelector('style[data-katex-scrollbar]')) {
			style.setAttribute('data-katex-scrollbar', 'true');
			document.head.appendChild(style);
		}

		element.setAttribute('data-scrollbar-initialized', 'true');
	});
}

function activateDeferredBanner(wrapper: Element | null | undefined, priority: "high" | "low" | "auto" = "low"): Promise<void> {
	const image = wrapper?.querySelector<HTMLImageElement>("img");
	if (!image) return Promise.resolve();
	const deferredSrc = image.dataset.bannerSrc;
	if (!deferredSrc) return typeof image.decode === "function" ? image.decode().catch(() => {}) : Promise.resolve();
	const localFallback = image.dataset.bannerLocal || null;
	return new Promise<void>((resolve) => {
		const finish = () => resolve();
		image.fetchPriority = priority;
		image.addEventListener("load", finish, { once: true });
		image.addEventListener("error", () => {
			if (localFallback && image.src !== localFallback) {
				// CDN 失败 → 回退本地
				image.addEventListener("load", finish, { once: true });
				image.addEventListener("error", finish, { once: true });
				image.src = localFallback;
			} else {
				finish();
			}
		}, { once: true });
		image.src = deferredSrc;
		delete image.dataset.bannerSrc;
		delete image.dataset.bannerLocal;
	});
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	requestAnimationFrame(() => {
		const initializeBanner = () => {
			const desktopBanner = document.querySelector('[data-banner-device="desktop"][data-banner-index="0"]');
			const mobileBanner = document.querySelector('[data-banner-device="mobile"][data-banner-index="0"]');
			if (!document.getElementById("banner-carousel")) {
				const bannerRuntime = window as typeof window & {
					__tonksBannerCarouselCleanup?: () => void;
				};
				bannerRuntime.__tonksBannerCarouselCleanup?.();
				const deviceQuery = window.matchMedia("(max-width: 1023px)");
				const wrapper = document.getElementById("banner-wrapper");
				const updateSingleBanner = () => {
					if (deviceQuery.matches && wrapper?.classList.contains("mobile-hide-banner")) return;
					const activeSingleBanner = deviceQuery.matches ? mobileBanner : desktopBanner;
					if (!activeSingleBanner) return;
					void activateDeferredBanner(activeSingleBanner, "high");
					activeSingleBanner.classList.remove("opacity-0", "scale-105");
					activeSingleBanner.classList.add("opacity-100");
				};
				const wrapperObserver = wrapper
					? new MutationObserver(updateSingleBanner)
					: undefined;
				deviceQuery.addEventListener("change", updateSingleBanner);
				wrapperObserver?.observe(wrapper!, { attributes: true, attributeFilter: ["class"] });
				bannerRuntime.__tonksBannerCarouselCleanup = () => {
					deviceQuery.removeEventListener("change", updateSingleBanner);
					wrapperObserver?.disconnect();
				};
				updateSingleBanner();
			}

			if (document.getElementById("banner-carousel")) initCarousel();
		};

		const loadingScreen = document.getElementById("initial-loading-screen");
		if (loadingScreen && loadingScreen.dataset.complete !== "true") {
			window.addEventListener("tonks:initial-loader:done", initializeBanner, { once: true });
		} else {
			initializeBanner();
		}
	});
}
function initCarousel() {
	const bannerRuntime = window as typeof window & {
		__tonksBannerCarouselCleanup?: () => void;
	};
	bannerRuntime.__tonksBannerCarouselCleanup?.();

	const carouselItems = Array.from(document.querySelectorAll(".carousel-item"));
	const carousel = document.getElementById("banner-carousel");
	if (!carouselItems.length || !carousel) return;

	const bannerWrapper = document.getElementById("banner-wrapper");
	const deviceQuery = window.matchMedia("(max-width: 1023px)");
	const carouselEnabled = Boolean(siteConfig.banner.carousel?.enable);
	const interval = siteConfig.banner.carousel?.interval || 6;
	let validItems: Element[] = [];
	let currentIndex = 0;
	let carouselInterval: ReturnType<typeof setInterval> | undefined;
	let isPaused = false;
	let disposed = false;
	let switchGeneration = 0;
	let startX = 0;
	let startY = 0;
	let isSwiping = false;
	let hasInitialized = false;

	const getDevice = (): "mobile" | "desktop" => deviceQuery.matches ? "mobile" : "desktop";
	const getValidItems = () => carouselItems.filter((item) =>
		item.querySelector(
			deviceQuery.matches ? ".block.lg\\:hidden" : ".hidden.lg\\:block",
		),
	);

	function activateItemImage(item: Element | undefined, priority: "high" | "low" | "auto" = "low", device = getDevice()) {
		const wrapper = item?.querySelector(`[data-banner-device="${device}"]`);
		return activateDeferredBanner(wrapper, priority);
	}

	function stopCarousel() {
		if (carouselInterval) clearInterval(carouselInterval);
		carouselInterval = undefined;
	}

	function startCarousel() {
		stopCarousel();
		if (!carouselEnabled || validItems.length < 2 || disposed) return;
		carouselInterval = setInterval(() => {
			if (!isPaused) {
				void switchToSlide((currentIndex + 1) % validItems.length);
			}
		}, interval * 1000);
	}

	function hideAllItems() {
		carouselItems.forEach((item) => {
			item.classList.add("opacity-0", "scale-110");
			item.classList.remove("opacity-100", "scale-100");
		});
	}

	async function switchToSlide(index: number, initial = false) {
		if (!validItems.length) return;
		const generation = ++switchGeneration;
		if (deviceQuery.matches && bannerWrapper?.classList.contains("mobile-hide-banner")) return;
		const device = getDevice();
		const nextIndex = ((index % validItems.length) + validItems.length) % validItems.length;
		const nextItem = validItems[nextIndex];
		await activateItemImage(nextItem, "high", device);
		if (disposed || generation !== switchGeneration || device !== getDevice()) return;

		// 服务端已经为首张图设置了正确的可见状态。首次初始化时若再次
		// hideAllItems，会触发 scale(1) → scale(1.15) → scale(1) 的抖动。
		if (!initial) hideAllItems();
		currentIndex = nextIndex;
		nextItem.classList.add("opacity-100", "scale-100");
		nextItem.classList.remove("opacity-0", "scale-110");
		if (carouselEnabled && validItems.length > 1) {
			void activateItemImage(validItems[(currentIndex + 1) % validItems.length], "low", device);
		}
	}

	function rebuildForDevice() {
		const previousItem = validItems[currentIndex];
		stopCarousel();
		validItems = getValidItems();

		let nextIndex = previousItem ? validItems.indexOf(previousItem) : -1;
		if (deviceQuery.matches && bannerWrapper?.classList.contains("mobile-hide-banner")) {
			switchGeneration++;
			hideAllItems();
			return;
		}
		if (nextIndex < 0) {
			nextIndex = !carouselEnabled && validItems.length > 1
				? Math.floor(Math.random() * validItems.length)
				: 0;
		}
		currentIndex = nextIndex;
		void switchToSlide(currentIndex, !hasInitialized).then(() => {
			hasInitialized = true;
			startCarousel();
		});
	}

	const handleDeviceChange = () => rebuildForDevice();
	const handleTouchStart = (event: TouchEvent) => {
		startX = event.touches[0].clientX;
		startY = event.touches[0].clientY;
		isSwiping = false;
		isPaused = true;
		stopCarousel();
	};
	const handleTouchMove = (event: TouchEvent) => {
		if (!startX || !startY) return;
		const diffX = Math.abs(event.touches[0].clientX - startX);
		const diffY = Math.abs(event.touches[0].clientY - startY);
		if (diffX > diffY && diffX > 30) {
			isSwiping = true;
			event.preventDefault();
		}
	};
	const handleTouchEnd = (event: TouchEvent) => {
		if (startX && startY && isSwiping && validItems.length > 1) {
			const diffX = startX - event.changedTouches[0].clientX;
			if (Math.abs(diffX) > 50) {
				const offset = diffX > 0 ? 1 : -1;
				void switchToSlide(currentIndex + offset);
			}
		}
		startX = 0;
		startY = 0;
		isSwiping = false;
		isPaused = false;
		startCarousel();
	};
	const handleMouseEnter = () => {
		isPaused = true;
		stopCarousel();
	};
	const handleMouseLeave = () => {
		isPaused = false;
		startCarousel();
	};

	deviceQuery.addEventListener("change", handleDeviceChange);
	const wrapperObserver = bannerWrapper
		? new MutationObserver(rebuildForDevice)
		: undefined;
	wrapperObserver?.observe(bannerWrapper!, { attributes: true, attributeFilter: ["class"] });
	if ("ontouchstart" in window) {
		carousel.addEventListener("touchstart", handleTouchStart, { passive: true });
		carousel.addEventListener("touchmove", handleTouchMove, { passive: false });
		carousel.addEventListener("touchend", handleTouchEnd, { passive: true });
	}
	carousel.addEventListener("mouseenter", handleMouseEnter);
	carousel.addEventListener("mouseleave", handleMouseLeave);

	bannerRuntime.__tonksBannerCarouselCleanup = () => {
		disposed = true;
		switchGeneration++;
		stopCarousel();
		deviceQuery.removeEventListener("change", handleDeviceChange);
		carousel.removeEventListener("touchstart", handleTouchStart);
		carousel.removeEventListener("touchmove", handleTouchMove);
		wrapperObserver?.disconnect();
		carousel.removeEventListener("touchend", handleTouchEnd);
		carousel.removeEventListener("mouseenter", handleMouseEnter);
		carousel.removeEventListener("mouseleave", handleMouseLeave);
	};

	rebuildForDevice();
}



const setup = () => {
	// ScriptsPlugin 会在内容替换后再次执行布局脚本。只注册一次全局钩子，
	// 避免多次文章切换后相同的延迟操作不断叠加。
	if (window.__tonksLayoutSwupHooksReady) return;
	window.__tonksLayoutSwupHooksReady = true;

	// @swup/astro 1.x 没有透传该核心选项；运行时启用后，鼠标侧键、
	// 浏览器前进/后退也会使用页面过渡。ScrollPlugin 负责恢复原滚动位置。
	window.swup.options.animateHistoryBrowsing = true;
	window.history.scrollRestoration = 'manual';
	let scrollRestoreInputController: AbortController | null = null;
	const stopWatchingScrollRestore = () => {
		scrollRestoreInputController?.abort();
		scrollRestoreInputController = null;
	};

	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// 简化navbar处理逻辑
		if (bannerEnabled) {
			const navbar = document.getElementById('navbar-wrapper')
			if (navbar && document.body.classList.contains('lg:is-home')) {
				const threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 88
				if (document.documentElement.scrollTop >= threshold) {
					navbar.classList.add('navbar-hidden')
				}
			}
		}
	})
	window.swup.hooks.on('content:replace', () => {
		// 只处理新的katex元素的滚动条，使用原生CSS滚动条
		initCustomScrollbar();
		
		// 左右目录都在 Swup 容器外，节点会跨页保留。
		// 以新正文为唯一依据，同步可见性并重建每一个实例。
		const tocWrapper = document.getElementById('toc-wrapper');
		const contentRoot = document.querySelector('.custom-md, .markdown-content, .prose');
		const isArticlePage = Boolean(contentRoot?.querySelector('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]'));
		if (tocWrapper) tocWrapper.hidden = !isArticlePage;
		
		document.querySelectorAll('table-of-contents').forEach((tocElement) => {
			if (typeof (tocElement as any).init === 'function') {
				(tocElement as any).init();
			}
		});
			
		if (isArticlePage) {
			// 重新初始化移动端 TOC 组件
			if (typeof (window as any).mobileTOCInit === 'function') {
				setTimeout(() => {
					(window as any).mobileTOCInit();
				}, 100);
			}
		}
		
		
		
		// 重新初始化semifull模式的滚动检测
		const navbar = document.getElementById('navbar')
		if (navbar) {
			const transparentMode = navbar.getAttribute('data-transparent-mode')
			
			if (transparentMode === 'semifull') {
				// 重新调用初始化函数来重新绑定滚动事件
				if (typeof (window as any).initSemifullScrollDetection === 'function') {
					(window as any).initSemifullScrollDetection()
				}
			}
		}
	})
	window.swup.hooks.on('visit:start', (visit: {
		to: {url: string};
		scroll: {reset: boolean};
	}) => {
		window.scrollProtectionManager?.setPageTransitioning(true);
		stopWatchingScrollRestore();
		scrollRestoreInputController = new AbortController();
		const cancelPendingScrollRestore = () => {
			// The user now owns the viewport. Prevent ScrollPlugin's delayed
			// content:scroll hook from restoring an older cached Y position.
			visit.scroll.reset = false;
			window.scrollTo({ top: window.scrollY, left: window.scrollX, behavior: 'instant' });
			stopWatchingScrollRestore();
		};
		const passiveInputOptions = {
			passive: true,
			signal: scrollRestoreInputController.signal,
		};
		window.addEventListener('wheel', cancelPendingScrollRestore, passiveInputOptions);
		window.addEventListener('touchstart', cancelPendingScrollRestore, passiveInputOptions);
		window.addEventListener('pointerdown', cancelPendingScrollRestore, passiveInputOptions);
		window.addEventListener('keydown', cancelPendingScrollRestore, {
			signal: scrollRestoreInputController.signal,
		});
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		const isHomePage = pathsEqual(visit.to.url, url('/'))
		
		if (isHomePage) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}

		// Control banner text visibility based on page
		const bannerTextOverlay = document.querySelector('.banner-text-overlay')
		if (bannerTextOverlay) {
			if (isHomePage) {
				bannerTextOverlay.classList.remove('hidden')
			} else {
				bannerTextOverlay.classList.add('hidden')
			}
		}

		// Control navbar transparency based on page
		const navbar = document.getElementById('navbar')
		if (navbar) {
			navbar.setAttribute('data-is-home', isHomePage.toString())
			
			// 重新初始化semifull模式的滚动检测
			const transparentMode = navbar.getAttribute('data-transparent-mode')
			if (transparentMode === 'semifull') {
				// 重新调用初始化函数来重新绑定滚动事件
				if (typeof window.initSemifullScrollDetection === 'function') {
					window.initSemifullScrollDetection()
				}
			}
		}

		// Control mobile banner visibility based on page with improved staging animation
		const bannerWrapper = document.getElementById('banner-wrapper')
		const mainContentWrapper = document.querySelector('.absolute.w-full.z-30')
		
		if (bannerWrapper && mainContentWrapper) {
			if (isHomePage) {
				// 首页：延迟移除隐藏类，让banner和内容优雅地出现
				setTimeout(() => {
					bannerWrapper.classList.remove('mobile-hide-banner')
				}, 100)
				setTimeout(() => {
					mainContentWrapper.classList.remove('mobile-main-no-banner')
				}, 150)
			} else {
				// 非首页：分阶段隐藏，先隐藏banner，再移动内容
				bannerWrapper.classList.add('mobile-hide-banner')
				// 延迟移动内容，让banner先完全消失
				setTimeout(() => {
					mainContentWrapper.classList.add('mobile-main-no-banner')
				}, 100)
			}
		}

		// NOTE: temporarily disabled height-extend logic for A/B testing because
		// it can trigger layout changes that cause scrollbar to appear/disappear
		// and lead to visual jitter on some platforms. If you want to re-enable,
		// remove the surrounding `if (false)` guard.
		if (false) {
			// increase the page height during page transition to prevent the scrolling animation from jumping
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.remove('hidden')
			}
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		// NOTE: disabled for A/B test
		if (false) {
			// hide the temp high element when the transition is done
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.remove('hidden')
			}
		}
		
		// 同步主题状态 - 解决从首页进入文章页面时代码块渲染问题
		const storedTheme = getStoredTheme();
		const isDark = isThemeDark(storedTheme);
		const expectedTheme = isDark ? 'github-dark' : 'github-light';
		const currentTheme = document.documentElement.getAttribute('data-theme');
		
		// 如果主题不匹配，强制重新应用
		if (currentTheme !== expectedTheme) {
			document.documentElement.setAttribute('data-theme', expectedTheme);
			// 触发代码块重新渲染
			setTimeout(() => {
				window.dispatchEvent(new CustomEvent('theme-change'));
			}, 50);
		}
		
		// 检查当前页面是否为文章页面，如果是则触发自定义事件用于初始化评论系统
		setTimeout(() => {
			if (document.getElementById('tcomment')) {
				// 触发自定义事件，通知评论系统页面已完全加载
				const pageLoadedEvent = new CustomEvent('mizuki:page:loaded', {
					detail: {
						path: window.location.pathname,
						timestamp: Date.now()
					}
				});
				document.dispatchEvent(pageLoadedEvent);
				console.log('Layout: 触发 mizuki:page:loaded 事件，路径:', window.location.pathname);
			}
		}, 300);
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		stopWatchingScrollRestore();
		window.scrollProtectionManager?.disable();
		requestAnimationFrame(() => {
			window.scrollProtectionManager?.setPageTransitioning(false);
		});
		setTimeout(() => {
			// NOTE: disabled heightExtend toggling for A/B testing. If this block
			// is re-enabled, ensure it does not cause scrollbar flicker on Windows.
			// Just make the transition looks better
			const toc = document.getElementById('toc-wrapper');
			if (toc) {
				toc.classList.remove('toc-not-ready')
			}
		}, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let navbar = document.getElementById('navbar-wrapper')

// 节流函数
function throttle(func: Function, limit: number) {
	let inThrottle: boolean;
	return function(this: any) {
		const args = arguments;
		const context = this;
		if (!inThrottle) {
			func.apply(context, args);
			inThrottle = true;
			setTimeout(() => inThrottle = false, limit);
		}
	}
}

function scrollFunction() {
	const scrollTop = document.documentElement.scrollTop;
	const bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100);

	// 批量处理DOM操作
	requestAnimationFrame(() => {
		if (backToTopBtn) {
			if (scrollTop > bannerHeight) {
				backToTopBtn.classList.remove('hide')
			} else {
				backToTopBtn.classList.add('hide')
			}
		}

		if (bannerEnabled && toc) {
			if (scrollTop > bannerHeight) {
				toc.classList.remove('toc-hide')
			} else {
				toc.classList.add('toc-hide')
			}
		}

		if (bannerEnabled && navbar) {
			const isHome = document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024;
			const currentBannerHeight = isHome ? BANNER_HEIGHT_HOME : BANNER_HEIGHT;
			const threshold = window.innerHeight * (currentBannerHeight / 100) - 88;
			
			if (scrollTop >= threshold) {
				navbar.classList.add('navbar-hidden')
			} else {
				navbar.classList.remove('navbar-hidden')
			}
		}
	});
}

// 使用节流优化滚动性能
window.onscroll = throttle(scrollFunction, 16); // 约60fps

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

// 页面加载完成后初始化banner和轮播图
if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', () => {
		showBanner();
	});
} else {
	showBanner();
}

</script>

